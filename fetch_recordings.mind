// List, hash and verify the public recordings named by each scorecard's links file.
// A missing file is reported and left absent. Measured by STARGA; not verified by ARC Prize.

fn fr_cmdrec() -> i64 {
    let rec: i64 = __mind_alloc(16);
    let pathb: i64 = fr_bnew(24);
    let _p: i64 = fr_bstr(pathb, "/proc/self/cmdline");
    let buf: i64 = __mind_alloc(65536);
    let n: i64 = read_file_native(fr_cstr(pathb), buf, 65535);
    __mind_store_i64(rec + 0, buf);
    __mind_store_i64(rec + 8, n);
    rec
}

fn fr_argc() -> i64 {
    let rec: i64 = fr_cmdrec();
    let buf: i64 = __mind_load_i64(rec + 0);
    let n: i64 = __mind_load_i64(rec + 8);
    if n <= 0 {
        return 0;
    }
    let mut i: i64 = 0;
    let mut c: i64 = 0;
    while i < n {
        if __mind_load_i8(buf + i) == 0 {
            c = c + 1;
        }
        i = i + 1;
    }
    c
}

fn fr_argv(index: i64) -> String {
    let rec: i64 = fr_cmdrec();
    let buf: i64 = __mind_load_i64(rec + 0);
    let n: i64 = __mind_load_i64(rec + 8);
    let mut i: i64 = 0;
    let mut seen: i64 = 0;
    while i < n {
        if seen == index {
            let mut j: i64 = i;
            while j < n {
                if __mind_load_i8(buf + j) == 0 {
                    return String { addr: buf + i, len: j - i, cap: 0 };
                }
                j = j + 1;
            }
            return String { addr: buf + i, len: n - i, cap: 0 };
        }
        if __mind_load_i8(buf + i) == 0 {
            seen = seen + 1;
        }
        i = i + 1;
    }
    String { addr: buf, len: 0, cap: 0 }
}

fn fr_eq(a: i64, an: i64, b: i64, bn: i64) -> i64 {
    if an != bn {
        return 0;
    }
    let mut i: i64 = 0;
    while i < an {
        if (__mind_load_i8(a + i) & 255) != (__mind_load_i8(b + i) & 255) {
            return 0;
        }
        i = i + 1;
    }
    1
}

fn fr_streq(a: String, b: String) -> i64 {
    fr_eq(string_addr(a), string_len(a), string_addr(b), string_len(b))
}

fn fr_starts(a: String, b: String) -> i64 {
    if string_len(a) < string_len(b) {
        return 0;
    }
    fr_eq(string_addr(a), string_len(b), string_addr(b), string_len(b))
}

fn fr_after(a: String, prefix: String) -> String {
    let n: i64 = string_len(prefix);
    String { addr: string_addr(a) + n, len: string_len(a) - n, cap: 0 }
}

fn fr_bnew(cap: i64) -> i64 {
    let rec: i64 = __mind_alloc(24);
    let data: i64 = __mind_alloc(cap);
    __mind_store_i64(rec + 0, data);
    __mind_store_i64(rec + 8, 0);
    __mind_store_i64(rec + 16, cap);
    rec
}

fn fr_blen(b: i64) -> i64 {
    __mind_load_i64(b + 8)
}

fn fr_bdata(b: i64) -> i64 {
    __mind_load_i64(b + 0)
}

fn fr_bpush(b: i64, byte: i64) -> i64 {
    let n: i64 = fr_blen(b);
    let cap: i64 = __mind_load_i64(b + 16);
    if n >= cap {
        let ncap: i64 = if cap < 64 { 128 } else { cap * 2 };
        let nd: i64 = __mind_realloc(fr_bdata(b), ncap);
        __mind_store_i64(b + 0, nd);
        __mind_store_i64(b + 16, ncap);
    }
    __mind_store_i8(fr_bdata(b) + fr_blen(b), byte);
    __mind_store_i64(b + 8, fr_blen(b) + 1);
    b
}

fn fr_bmem(b: i64, p: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut out: i64 = b;
    while i < n {
        out = fr_bpush(out, __mind_load_i8(p + i));
        i = i + 1;
    }
    out
}

fn fr_bstr(b: i64, s: String) -> i64 {
    fr_bmem(b, string_addr(s), string_len(s))
}

fn fr_emit(b: i64) -> i64 {
    print_bytes(fr_bdata(b), fr_blen(b));
    0
}

fn fr_err(b: i64) -> i64 {
    let _w: i64 = __mind_write(2, fr_bdata(b), fr_blen(b), 0 - 1);
    0
}

fn fr_cstr(b: i64) -> i64 {
    let n: i64 = fr_blen(b);
    let p: i64 = __mind_alloc(n + 1);
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(p + i, __mind_load_i8(fr_bdata(b) + i));
        i = i + 1;
    }
    __mind_store_i8(p + n, 0);
    p
}

fn fr_bpush_i64(b: i64, n: i64) -> i64 {
    if n == 0 {
        return fr_bpush(b, 48);
    }
    let mut nn: i64 = n;
    let mut out: i64 = b;
    if n < 0 {
        out = fr_bpush(out, 45);
        nn = 0 - n;
    }
    let mut div: i64 = 1;
    let mut tmp: i64 = nn;
    while tmp >= 10 {
        div = div * 10;
        tmp = tmp / 10;
    }
    while div > 0 {
        let digit: i64 = (nn / div) % 10;
        out = fr_bpush(out, 48 + digit);
        div = div / 10;
    }
    out
}

fn fr_zw(b: i64, n: i64, width: i64) -> i64 {
    let mut digits: i64 = 1;
    let mut tmp: i64 = n;
    while tmp >= 10 {
        digits = digits + 1;
        tmp = tmp / 10;
    }
    let mut out: i64 = b;
    let mut pad: i64 = width - digits;
    while pad > 0 {
        out = fr_bpush(out, 48);
        pad = pad - 1;
    }
    fr_bpush_i64(out, n)
}

fn fr_hexdigit(n: i64) -> i64 {
    if n < 10 {
        return 48 + n;
    }
    87 + n
}

fn fr_bpush_hex(b: i64, dig: i64, nbytes: i64) -> i64 {
    let mut out: i64 = b;
    let mut i: i64 = 0;
    while i < nbytes {
        let v: i64 = __mind_load_i8(dig + i) & 255;
        out = fr_bpush(out, fr_hexdigit(v / 16));
        out = fr_bpush(out, fr_hexdigit(v % 16));
        i = i + 1;
    }
    out
}

fn fr_copy(p: i64, n: i64) -> i64 {
    let d: i64 = __mind_alloc(n + 1);
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(d + i, __mind_load_i8(p + i));
        i = i + 1;
    }
    __mind_store_i8(d + n, 0);
    d
}

fn fr_is_ws(c: i64) -> i64 {
    let u: i64 = c & 255;
    if u == 32 || u == 9 || u == 13 || u == 11 || u == 12 { 1 } else { 0 }
}

fn fr_ltrim(p: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        if fr_is_ws(__mind_load_i8(p + i)) == 1 {
            i = i + 1;
        } else {
            return i;
        }
    }
    n
}

fn fr_rtrim(p: i64, n: i64) -> i64 {
    let mut i: i64 = n;
    while i > 0 {
        if fr_is_ws(__mind_load_i8(p + i - 1)) == 1 {
            i = i - 1;
        } else {
            return i;
        }
    }
    0
}

fn fr_starts_http(p: i64, n: i64) -> i64 {
    if n < 4 {
        return 0;
    }
    if (__mind_load_i8(p) & 255) == 104 {
        if (__mind_load_i8(p + 1) & 255) == 116 {
            if (__mind_load_i8(p + 2) & 255) == 116 {
                if (__mind_load_i8(p + 3) & 255) == 112 {
                    return 1;
                }
            }
        }
    }
    0
}

fn fr_name_less(ap: i64, an: i64, bp: i64, bn: i64) -> i64 {
    let mut i: i64 = 0;
    let n: i64 = if an < bn { an } else { bn };
    while i < n {
        let ca: i64 = __mind_load_i8(ap + i) & 255;
        let cb: i64 = __mind_load_i8(bp + i) & 255;
        if ca < cb {
            return 1;
        }
        if ca > cb {
            return 0;
        }
        i = i + 1;
    }
    if an < bn { 1 } else { 0 }
}

fn fr_usage() -> i64 {
    let m: String = "fetch_recordings: error: unrecognised argument\n";
    let _w: i64 = __mind_write(2, string_addr(m), string_len(m), 0 - 1);
    2
}

fn fr_need_manifest() -> i64 {
    let m: String = "fetch_recordings: error: manifest required\n";
    let _w: i64 = __mind_write(2, string_addr(m), string_len(m), 0 - 1);
    2
}

fn fr_default_community(buf: i64) -> i64 {
    let a0: String = fr_argv(0);
    let tmp: i64 = fr_bnew(string_len(a0) + 1);
    let _w: i64 = fr_bstr(tmp, a0);
    let rec: i64 = canonicalize(fr_cstr(tmp));
    let addr: i64 = __mind_load_i64(rec + 0);
    let len: i64 = __mind_load_i64(rec + 8);
    if len <= 0 {
        return 0;
    }
    let mut slash: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < len {
        if (__mind_load_i8(addr + i) & 255) == 47 {
            slash = i;
        }
        i = i + 1;
    }
    if slash <= 0 {
        return 0;
    }
    let mut slash2: i64 = 0 - 1;
    i = 0;
    while i < slash {
        if (__mind_load_i8(addr + i) & 255) == 47 {
            slash2 = i;
        }
        i = i + 1;
    }
    if slash2 <= 0 {
        return 0;
    }
    let _c: i64 = fr_bmem(buf, addr, slash2);
    fr_bstr(buf, "/community")
}

fn fr_arr(slots: i64, k: i64) -> i64 {
    __mind_load_i64(slots + k * 8)
}

fn fr_at(slots: i64, k: i64, i: i64) -> i64 {
    __mind_load_i64(fr_arr(slots, k) + i * 8)
}

fn fr_put(slots: i64, k: i64, i: i64, v: i64) -> i64 {
    __mind_store_i64(fr_arr(slots, k) + i * 8, v);
    0
}

