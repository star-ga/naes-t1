fn fr_dest(comm_p: i64, comm_n: i64, out_p: i64, out_n: i64, have_out: i64, sc_p: i64, sc_n: i64, g_p: i64, g_n: i64, id_p: i64, id_n: i64) -> i64 {
    let b: i64 = fr_bnew(comm_n + out_n + sc_n + g_n + id_n + 32);
    let mut o: i64 = b;
    if have_out == 1 {
        o = fr_bmem(o, out_p, out_n);
        o = fr_bpush(o, 47);
        o = fr_bmem(o, sc_p, sc_n);
        o = fr_bpush(o, 47);
    } else {
        o = fr_bmem(o, comm_p, comm_n);
        o = fr_bpush(o, 47);
        o = fr_bmem(o, sc_p, sc_n);
        o = fr_bstr(o, "/recordings/");
    }
    o = fr_bmem(o, g_p, g_n);
    o = fr_bstr(o, "__");
    o = fr_bmem(o, id_p, id_n);
    o = fr_bstr(o, ".jsonl");
    o
}

fn fr_tab_count(p: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut c: i64 = 1;
    if n == 0 {
        return 0;
    }
    while i < n {
        if (__mind_load_i8(p + i) & 255) == 9 {
            c = c + 1;
        }
        i = i + 1;
    }
    c
}

fn fr_tab_field(p: i64, n: i64, index: i64, out: i64) -> i64 {
    let mut i: i64 = 0;
    let mut field: i64 = 0;
    let mut start: i64 = 0;
    let mut done: i64 = 0;
    while done == 0 {
        if i >= n {
            if field == index {
                __mind_store_i64(out + 0, p + start);
                __mind_store_i64(out + 8, i - start);
            } else {
                __mind_store_i64(out + 0, p);
                __mind_store_i64(out + 8, 0);
            }
            done = 1;
        } else {
            if (__mind_load_i8(p + i) & 255) == 9 {
                if field == index {
                    __mind_store_i64(out + 0, p + start);
                    __mind_store_i64(out + 8, i - start);
                    done = 1;
                } else {
                    field = field + 1;
                    start = i + 1;
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        }
    }
    0
}

fn fr_load_manifest(path_cstr: i64, slots: i64, cap: i64) -> i64 {
    let text: i64 = read_to_string(path_cstr);
    let base: i64 = __mind_load_i64(text + 0);
    let n: i64 = __mind_load_i64(text + 8);
    if n <= 0 {
        return 0 - 1;
    }
    let mut pos: i64 = 0;
    let mut row: i64 = 0;
    let mut stored: i64 = 0;
    while pos < n {
        let info: i64 = __mind_alloc(24);
        let _tl: i64 = fr_take_line(base, n, pos, info);
        pos = __mind_load_i64(info + 0);
        let off: i64 = __mind_load_i64(info + 8);
        let ln: i64 = __mind_load_i64(info + 16);
        if row > 0 {
            if ln > 0 {
                if stored >= cap {
                    return 0 - 1;
                }
                if fr_tab_count(base + off, ln) >= 7 {
                    let fld: i64 = __mind_alloc(16);
                    let _a: i64 = fr_tab_field(base + off, ln, 0, fld);
                    let _s0: i64 = fr_put(slots, 0, stored, __mind_load_i64(fld + 0));
                    let _s1: i64 = fr_put(slots, 1, stored, __mind_load_i64(fld + 8));
                    let _b: i64 = fr_tab_field(base + off, ln, 1, fld);
                    let _s2: i64 = fr_put(slots, 2, stored, __mind_load_i64(fld + 0));
                    let _s3: i64 = fr_put(slots, 3, stored, __mind_load_i64(fld + 8));
                    let _c: i64 = fr_tab_field(base + off, ln, 2, fld);
                    let _s4: i64 = fr_put(slots, 4, stored, __mind_load_i64(fld + 0));
                    let _s5: i64 = fr_put(slots, 5, stored, __mind_load_i64(fld + 8));
                    let _d: i64 = fr_tab_field(base + off, ln, 6, fld);
                    let _s6: i64 = fr_put(slots, 6, stored, __mind_load_i64(fld + 0));
                    let _s7: i64 = fr_put(slots, 7, stored, __mind_load_i64(fld + 8));
                    stored = stored + 1;
                }
            }
        }
        row = row + 1;
    }
    stored
}

fn fr_find_row(slots: i64, n: i64, sc_p: i64, sc_n: i64, g_p: i64, g_n: i64, id_p: i64, id_n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        if fr_eq(fr_at(slots, 0, i), fr_at(slots, 1, i), sc_p, sc_n) == 1 {
            if fr_eq(fr_at(slots, 2, i), fr_at(slots, 3, i), g_p, g_n) == 1 {
                if fr_eq(fr_at(slots, 4, i), fr_at(slots, 5, i), id_p, id_n) == 1 {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    0 - 1
}

