# ===========================================================================
# abstraction framework
# ===========================================================================
class Abstraction:
    """A sound admissible lower bound on moves-to-win, over the live game object.

    h(game)          -> int   admissible LB on remaining moves (>= 0).
    move_bound       :  int   claimed max change of h per legal move (consistency).
    argument         :  str   the explicit structural lower-bound argument.
    ok               :  bool  False => not usable (fields not found / not verified).
    """

    def __init__(self, name, h, move_bound, argument, ok=True, meta=None):
        self.name = name
        self.h = h
        self.move_bound = move_bound
        self.argument = argument
        self.ok = ok
        self.meta = meta or {}


def _leaves_numeric(obj, path=(), out=None, depth=0, seen=None):
    """Flatten small-integer scalar leaves of an engine object into {path: int}.

    Only ints in a plausible grid-coordinate range are kept; big arrays/strings are
    skipped. Deterministic. Used to AUTO-DISCOVER the agent coordinate leaves (the
    scalars that move by exactly one unit under a move action)."""
    if out is None:
        out = {}
    if seen is None:
        seen = set()
    if depth > 8:
        return out
    oid = id(obj)
    if oid in seen:
        return out
    if isinstance(obj, bool):
        return out
    if isinstance(obj, int):
        if -8 <= obj <= 200:
            out[path] = obj
        return out
    seen = seen | {oid}
    if isinstance(obj, (list, tuple)):
        if len(obj) <= 16:
            for i, e in enumerate(obj):
                _leaves_numeric(e, path + (i,), out, depth + 1, seen)
        return out
    d = getattr(obj, "__dict__", None)
    if isinstance(obj, dict):
        d = obj
    if d:
        for k in sorted(d, key=str):
            if isinstance(k, str) and k.startswith("__"):
                continue
            _leaves_numeric(d[k], path + (str(k),), out, depth + 1, seen)
    return out


def _manhattan(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


# ===========================================================================
# df-pn / IDA* proof engine  (single-agent depth-first proof-number search)
# ===========================================================================
def _avail(g):
    try:
        return [int(v) for v in (getattr(g, "_available_actions", None) or [])]
    except (TypeError, ValueError):
        return []


def _actions_for(tape, game, alphabet, click_probe, hw):
    """Concrete (a,x,y) actions available at a state. Simple actions from `alphabet`
    filtered by the live availability; ACTION6 (click) expanded to the SOUND complete
    per-state click alphabet (probe every cell, cluster by complete-key child) when
    click_probe is on. Complete over the click space => a BFS/df-pn over it stays a
    sound floor proof for click games (see mmae_minimum.probe_state_clicks)."""
    cur = _avail(game)
    acts = [ak for ak in alphabet if not cur or ak[0] in cur]
    if click_probe and (not cur or 6 in cur):
        h, w = hw
        acts = acts + [(6, x, y) for (x, y) in M.probe_state_clicks(tape, h, w)]
    return acts


class ProofResult:
    def __init__(self):
        self.floor = None          # proven exact floor (int) or None
        self.proven = False
        self.path = []             # in-level winning action sequence at `floor`
        self.lb = 0                # best proven lower bound
        self.ub = None             # best known upper bound (route or found win)
        self.nodes = 0
        self.consistency_ok = True
        self.consistency_violation = None
        self.budget_hit = False
        self.iters = []            # per-d: (d, "win@L" | "exhausted" | "budget")


def dfpn_floor(start_z, base_lc, alphabet, absn: Abstraction, node_cap,
               d_lo, d_hi, progress=True, click_probe=False, hw=(64, 64)):
    """Iterative-deepening df-pn. Proves P(d) := exists win within d moves, for
    d = d_lo .. d_hi. First proven d = exact floor (given absn admissible).
    Returns ProofResult. `alphabet` = list of (a, x, y). h from absn.h(game)."""
    res = ProofResult()
    hstart_g = M.restore(start_z)
    M.frame_of(M.act(M.restore(start_z), 0)) if False else None  # keep import warm
    # h at start
    try:
        h0 = absn.h(hstart_g)
    except Exception as e:  # noqa: BLE001
        res.consistency_ok = False
        res.consistency_violation = f"h(start) failed: {e!r}"
        return res
    res.lb = max(res.lb, h0)
    bound = absn.move_bound
    t0 = time.time()

    for d in range(max(d_lo, h0), d_hi + 1):
        # depth-first search with f = g + h <= d, transposition table on min-g.
        tt = {}  # state_hash -> min g reached this iteration
        # stack entries: (tape, g). We (re)restore per node to expand its children.
        start_hash = M.whitebox_sig(M.restore(start_z))
        tt[start_hash] = 0
        stack = [(start_z, 0)]
        win_path = None
        iter_budget_hit = False
        while stack:
            tape, gv = stack.pop()
            if res.nodes >= node_cap:
                iter_budget_hit = True
                break
            # expand children
            children = []  # (child_tape, gnext, child_hash, hc) to push (reverse for det order)
            gp = M.restore(tape)
            ph = absn.h(gp)
            for (a, x, y) in _actions_for(tape, gp, alphabet, click_probe, hw):
                gc = M.restore(tape)
                fd = M.act(gc, a, x, y)
                res.nodes += 1
                # EmptyFrame => silent engine failure; never fabricate. Propagates.
                lc = M.lc_of(fd)
                sstr = str(getattr(fd, "state", ""))
                if lc > base_lc:
                    win_path = list(tape)[len(start_z):] + [(a, x, y)]
                    break
                if "GAME_OVER" in sstr:
                    continue
                M.frame_of(fd)  # validate engine really stepped (raise on empty)
                hc = absn.h(gc)
                # consistency (ii): a legal move may change h by at most move_bound.
                if ph - hc > bound:
                    res.consistency_ok = False
                    res.consistency_violation = (
                        f"h drop {ph}->{hc} > bound {bound} on action {a} at g={gv}")
                fnext = (gv + 1) + hc
                if fnext > d:
                    continue  # admissible prune: cannot reach a win within d
                ch = M.whitebox_sig(gc)
                prev = tt.get(ch)
                if prev is not None and prev <= gv + 1:
                    continue  # transposition already explored at <= this g
                tt[ch] = gv + 1
                children.append((tape + ((a, x, y),), gv + 1))
            if win_path is not None:
                break
            # push children (reversed so leftmost action explored first — determinism)
            for entry in reversed(children):
                stack.append(entry)
        if progress:
            tag = ("win" if win_path is not None else
                   "budget" if iter_budget_hit else "exhausted")
            sys.stderr.write(f"[dfpn] d={d} nodes={res.nodes} tt={len(tt)} "
                             f"{tag} {time.time() - t0:.0f}s\n")
        if win_path is not None:
            res.iters.append((d, f"win@{len(win_path)}"))
            res.floor = d
            res.proven = True
            res.path = win_path
            res.ub = d if res.ub is None else min(res.ub, d)
            return res
        if iter_budget_hit:
            res.iters.append((d, "budget"))
            res.budget_hit = True
            return res
        # iteration d fully exhausted, no win => floor > d
        res.iters.append((d, "exhausted"))
        res.lb = max(res.lb, d + 1)
    return res


# ===========================================================================
# FAST game-carrying IDA* (movement games, no click probe)
#
# The tape-based dfpn_floor above re-restores every node with M.restore(tape),
# which REPLAYS the whole (level-prefix + in-level) action tape per node — the
# O(prefix+depth) cost. This variant deepcopies the level-start game
# ONCE (the only prefix replay) and expands by copy.deepcopy(parent)+act — O(1)
# make/unmove on the deepcopy-verified backend. Identical proof semantics:
# iterative deepening on f=g+h, transposition table (min-g/iter) on the whitebox
# complete key, admissible prune f>d, per-edge consistency assertion. First
# proven d = exact floor. Used ONLY when click_probe is off (the click alphabet
# needs the tape for probe_state_clicks); movement games g50t/re86/wa30 qualify.
# ===========================================================================
def dfpn_floor_fast(start_z, base_lc, alphabet, absn: Abstraction, node_cap,
                    d_lo, d_hi, progress=True, time_budget=0):
    res = ProofResult()
    sys.setrecursionlimit(1_000_000)
    try:
        root = M.restore(start_z)
        h0 = absn.h(root)
    except Exception as e:  # noqa: BLE001
        res.consistency_ok = False
        res.consistency_violation = f"h(start) failed: {e!r}"
        return res
    res.lb = max(res.lb, h0)
    bound = absn.move_bound
    t0 = time.time()
    deadline = (t0 + time_budget) if time_budget else None

    for d in range(max(d_lo, h0), d_hi + 1):
        tt = {M.whitebox_sig(root): 0}
        flags = {"budget": False}

        def rec(game, gv, ph, path):
            if res.nodes >= node_cap or (deadline and time.time() > deadline):
                flags["budget"] = True
                return None
            cur = _avail(game)
            for (a, x, y) in [ak for ak in alphabet if not cur or ak[0] in cur]:
                gc = copy.deepcopy(game)
                fd = M.act(gc, a, x, y)
                res.nodes += 1
                lc = M.lc_of(fd)
                sstr = str(getattr(fd, "state", ""))
                if lc > base_lc:
                    return path + [(a, x, y)]        # win found at depth gv+1 == d
                if "GAME_OVER" in sstr:
                    continue
                M.frame_of(fd)                       # raise on silent engine failure
                hc = absn.h(gc)
                if ph - hc > bound:                  # consistency (ii) — voids 'proven'
                    res.consistency_ok = False
                    res.consistency_violation = (
                        f"h drop {ph}->{hc} > bound {bound} on action {a} at g={gv}")
                if gv + 1 + hc > d:
                    continue                         # admissible prune
                ch = M.whitebox_sig(gc)
                prev = tt.get(ch)
                if prev is not None and prev <= gv + 1:
                    continue                         # transposition seen at <= this g
                tt[ch] = gv + 1
                r = rec(gc, gv + 1, hc, path + [(a, x, y)])
                if r is not None:
                    return r
                if flags["budget"]:
                    return None
            return None

        win_path = rec(root, 0, h0, [])
        if progress:
            tag = ("win" if win_path is not None else
                   "budget" if flags["budget"] else "exhausted")
            sys.stderr.write(f"[dfpn-fast] d={d} nodes={res.nodes} tt={len(tt)} "
                             f"{tag} {time.time() - t0:.0f}s\n")
        if win_path is not None:
            res.iters.append((d, f"win@{len(win_path)}"))
            res.floor = d
            res.proven = True
            res.path = win_path
            res.ub = d if res.ub is None else min(res.ub, d)
            return res
        if flags["budget"]:
            res.iters.append((d, "budget"))
            res.budget_hit = True
            return res
        res.iters.append((d, "exhausted"))
        res.lb = max(res.lb, d + 1)
    return res


def precheck_move_bound_fast(start_z, base_lc, alphabet, absn, samples=400):
    """Game-carrying variant of precheck_move_bound (movement games): deepcopy-BFS
    up to `samples` states, confirm h never drops by > move_bound on any edge."""
    from collections import deque
    root = M.restore(start_z)
    try:
        absn.h(root)
    except Exception:  # noqa: BLE001
        return False, 10 ** 9, 0
    seen = {M.whitebox_sig(root)}
    q = deque([root])
    checked = 0
    worst = 0
    while q and checked < samples:
        game = q.popleft()
        try:
            ph = absn.h(game)
        except Exception:  # noqa: BLE001
            return False, 10 ** 9, checked
        checked += 1
        cur = _avail(game)
        for (a, x, y) in [ak for ak in alphabet if not cur or ak[0] in cur]:
            gc = copy.deepcopy(game)
            fd = M.act(gc, a, x, y)
            if M.lc_of(fd) > base_lc:
                continue
            if "GAME_OVER" in str(getattr(fd, "state", "")):
                continue
            try:
                M.frame_of(fd)
                hc = absn.h(gc)
            except Exception:  # noqa: BLE001
                continue
            worst = max(worst, ph - hc)
            if ph - hc > absn.move_bound:
                return False, ph - hc, checked
            ch = M.whitebox_sig(gc)
            if ch not in seen:
                seen.add(ch)
                q.append(gc)
    return True, worst, checked


# ===========================================================================
# forward layered BFS lower bound (heuristic-FREE, always sound) — for sandwiches
# ===========================================================================
def bfs_lower_bound(start_z, base_lc, alphabet, node_cap, depth_cap,
                    click_probe=False, hw=(64, 64)):
    """Close BFS layers on the whitebox graph; return (deepest fully-closed layer,
    hit_win_at or None, nodes). Heuristic-free: if all distinct states at depth
    < d are exhausted with no win, floor >= d. SOUND only over the COMPLETE action
    alphabet (simple + click_probe clicks) — a dropped click could hide a shorter
    win. Uses whitebox_sig dedup."""
    seen = {M.whitebox_sig(M.restore(start_z)): 0}
    frontier = [start_z]
    nodes = 0
    closed_depth = 0
    win_at = None
    for depth in range(1, depth_cap + 1):
        nxt = []
        for tape in frontier:
            gp = M.restore(tape)
            for (a, x, y) in _actions_for(tape, gp, alphabet, click_probe, hw):
                gc = M.restore(tape)
                fd = M.act(gc, a, x, y)
                nodes += 1
                lc = M.lc_of(fd)
                sstr = str(getattr(fd, "state", ""))
                if lc > base_lc:
                    win_at = depth if win_at is None else min(win_at, depth)
                    continue
                if "GAME_OVER" in sstr:
                    continue
                M.frame_of(fd)
                ch = M.whitebox_sig(gc)
                if ch not in seen:
                    seen[ch] = depth
                    nxt.append(tape + ((a, x, y),))
            if nodes >= node_cap:
                return closed_depth, win_at, nodes
        if win_at is not None and win_at <= depth:
            # a win appeared at this depth; if the whole layer closed, that's the floor
            closed_depth = depth
            return closed_depth, win_at, nodes
        closed_depth = depth
        frontier = nxt
        if not frontier:
            break
    return closed_depth, win_at, nodes


# ===========================================================================
# per-game abstraction builders  (fields grounded in each game's source)
# ===========================================================================
def _g50t_pos(g):
    c = g.vgwycxsxjz
    pl = c.dzxunlkwxt.xmdjbwrpmv
    go = c.whftgckbcu.xmdjbwrpmv
    return (int(pl.x), int(pl.y)), (int(go.x), int(go.y))


def build_g50t(start_game):
    """g50t: win <=> player cell == goal cell + (1,1). 6px/cell. ACTION1-4 move the
    agent <=1 cell (verified); ACTION5 = record-replay teleport to the FIXED start
    cell only. So floor >= manhattan(start,goal)=m0, and h(s)=min(manhattan(agent,
    goal), 1+m0) is admissible AND consistent (move_bound=1): any win either walks
    directly (>= manhattan) or does its last reset to start then walks (>= 1+m0)."""
    (p0, g0) = _g50t_pos(start_game)
    gc0 = (g0[0] + 1, g0[1] + 1)
    m0 = (abs(p0[0] - gc0[0]) + abs(p0[1] - gc0[1])) // 6

    def h(game):
        (p, go) = _g50t_pos(game)
        gc = (go[0] + 1, go[1] + 1)
        man = (abs(p[0] - gc[0]) + abs(p[1] - gc[1])) // 6
        return min(man, 1 + m0)

    return Abstraction("g50t_manhattan_min", h, 1,
                       f"floor >= manhattan(start_agent,goal) = {m0} cells (6px/cell). "
                       "ACTION1-4 move the agent <=1 cell; ACTION5 only teleports to the "
                       "fixed start, never nearer the goal, so any winning sequence needs "
                       f">= {m0} unit moves. h(s)=min(manhattan(agent,goal),1+m0) is "
                       "admissible & consistent (move_bound=1).", meta={"m0": m0})


def _dc22_pos(g):
    a = g.fdvakicpimr
    go = g.bqxa
    return (int(a.x), int(a.y)), (int(go.x), int(go.y))


def build_dc22(start_game):
    """dc22: win <=> agent cell == goal cell. 2px/cell. ACTION1-4 move <=1 cell.
    manhattan(agent,goal) is admissible+consistent ONLY when no reachable ACTION6
    itki-teleport exists (L1/L2). The move-bound self-check disables it (h=0) when a
    teleport that moves the agent >1 cell/action is observed (L3-L6)."""
    (a0, g0) = _dc22_pos(start_game)
    m0 = (abs(a0[0] - g0[0]) + abs(a0[1] - g0[1])) // 2

    def h(game):
        (a, go) = _dc22_pos(game)
        return (abs(a[0] - go[0]) + abs(a[1] - go[1])) // 2

    return Abstraction("dc22_manhattan", h, 1,
                       f"floor >= manhattan(agent,goal) = {m0} cells (2px/cell): each "
                       "ACTION1-4 moves the agent <=1 cell. Sound only when no reachable "
                       "ACTION6 itki-teleport (auto move-bound self-check).", meta={"m0": m0})


def _lf52_active(g):
    sc = g.ikhhdzfmarl
    pegs = [o for o in sc.hncnfaqaddg.kdsncymzyeb
            if str(getattr(o, "yrxvacxlgrf", "")).startswith("fozwvlovdui")]
    blue = int(getattr(sc, "lzoqlpcwzpu", 0) or 0)
    return len(pegs) - blue


def build_lf52(start_game):
    """lf52: peg-solitaire. win <=> active peg count == T (T=2 on L6/L7 else 1). Each
    same-color jump removes exactly one peg and costs >=1 click action; pushes/selects/
    undo remove none. So floor >= N_active-T; h = N_active-T, move_bound=1 (each action
    changes the count by <=1). NOT sokoban/matching (no box targets)."""
    sc = start_game.ikhhdzfmarl
    lvl = int(getattr(sc, "whtqurkphir", 1) or 1)
    T = 2 if lvl in (6, 7) else 1
    n0 = _lf52_active(start_game)

    def h(game):
        return max(0, _lf52_active(game) - T)

    return Abstraction("lf52_pegcount", h, 1,
                       f"floor >= N_active-T = {n0}-{T} = {n0 - T}: win needs the active "
                       "peg count reduced to T; each same-color jump removes exactly 1 peg "
                       "and needs >=1 click action; other actions remove 0. move_bound=1.",
                       meta={"T": T, "n0": n0})


# re86 runtime tags (copy 8af5384d, the one resolve_game_id loads): the win check
# jeiavrvavi() reads targets by TARGET tag, movable pieces by MOVABLE tag, and the base
# canvas asset by BASE key. If get_sprites_by_tag returns nothing (a different copy),
# U stays 0 and the win_zero self-check disables the abstraction (safe: no LB claimed).
RE86_TARGET_TAG = "0054xnsuqceejm"
RE86_MOVABLE_TAG = "0031cppcuvqlbi"
RE86_BASE_KEY = "0000wbshgbbxxc"


def _re86_globals(g):
    for v in type(g).__dict__.values():
        if hasattr(v, "__globals__"):
            return v.__globals__
    return {}


def _re86_unpainted(g):
    """U = count of target content pixels the piece-canvas does NOT match. Exact
    complement of the engine win predicate jeiavrvavi() (win <=> U == 0), replicated
    with the same base canvas + blit + (!=-1 & !=4 & !=canvas) test => sound feature."""
    gl = _re86_globals(g)
    spr = gl.get("sprites", {})
    if RE86_BASE_KEY in spr:
        canvas = np.array(spr[RE86_BASE_KEY].pixels).copy()
    else:
        canvas = np.full((64, 64), -1, dtype=np.int64)
    ch, cw = canvas.shape
    lvl = g.current_level
    for s in lvl.get_sprites_by_tag(RE86_MOVABLE_TAG):
        px = np.array(s.pixels)
        ox, oy = int(s.x), int(s.y)
        H, W = px.shape
        r0, r1 = max(0, -oy), min(H, ch - oy)
        c0, c1 = max(0, -ox), min(W, cw - ox)
        if r1 > r0 and c1 > c0:
            sub = px[r0:r1, c0:c1]
            dst = canvas[max(0, oy):min(ch, oy + H), max(0, ox):min(cw, ox + W)]
            m = sub != -1
            dst[m] = sub[m]
    U = 0
    for t in lvl.get_sprites_by_tag(RE86_TARGET_TAG):
        tp = np.array(t.pixels)
        U += int(((tp != -1) & (tp != 4) & (tp != canvas)).sum())
    return U


def build_re86(start_game):
    """re86: paint-coverage. win <=> every target content pixel is matched by a piece.
    One action moves ONE 3px-step piece / cycles the active piece, changing at most
    P_safe = max(max piece footprint, #pieces) target cells. h = ceil(U/P_safe) is
    admissible; move_bound on h = 1 (U drops by <= P_safe per action)."""
    lvl = start_game.current_level
    movs = lvl.get_sprites_by_tag(RE86_MOVABLE_TAG)
    psafe = 1
    for s in movs:
        px = np.array(s.pixels)
        psafe = max(psafe, int(((px != -1) & (px != 4)).sum()))
    psafe = max(psafe, len(movs))
    u0 = _re86_unpainted(start_game)

    def h(game):
        U = _re86_unpainted(game)
        return -(-U // psafe)  # ceil(U/psafe)

    return Abstraction("re86_paintcover", h, 1,
                       f"floor >= ceil(U/P_safe) with U0={u0} unsatisfied target content "
                       f"px and P_safe={psafe} (max piece footprint): one action moves one "
                       "piece one 3px step, satisfying <= P_safe cells, so >= ceil(U/P_safe) "
                       "actions. move_bound on h = 1.", meta={"psafe": psafe, "u0": u0})


# wa30 carry-sokoban tags (source environment_files/wa30/ee6fef47/wa30.py):
#   player  = tag "wbmdvjhthc"   boxes = tag "geezpjgiyd"
#   targets = self.wyzquhjerd    (set of target-region CELLS, 4px grid, celomdfhbh=4)
#   win  ymzfopzgbq() = all boxes' (x,y) in wyzquhjerd AND box not grabbed (zmqreragji)
#   enemies = tags "kdweefinfi" / "ysysltqlke" (auto-move each step -> move boxes -> break
#             move_bound=1). Only enemy-free levels admit the admissible sokoban LB.
WA30_BOX_TAG = "geezpjgiyd"
WA30_ENEMY_TAGS = ("kdweefinfi", "ysysltqlke")
WA30_CELL = 4


def _wa30_boxes_targets(g):
    boxes = [(int(s.x), int(s.y)) for s in g.current_level.get_sprites_by_tag(WA30_BOX_TAG)]
    targ = sorted((int(x), int(y)) for (x, y) in getattr(g, "wyzquhjerd", set()) or set())
    return boxes, targ


def _wa30_matching_lb(boxes, targ):
    """Min-cost matching(boxes -> DISTINCT target cells) with per-pair cost =
    manhattan/4 IF the target is on the box's 4-grid (a box only reaches targets
    congruent mod-4 by pure translation), else infeasible. Returns the summed
    carry-move LB, or None when some box has no reachable target (abstraction n/a)."""
    if not boxes:
        return 0
    if not targ:
        return None
    from scipy.optimize import linear_sum_assignment
    BIG = 10 ** 6
    cost = np.full((len(boxes), len(targ)), BIG, dtype=np.int64)
    for i, (bx, by) in enumerate(boxes):
        for j, (tx, ty) in enumerate(targ):
            if (tx - bx) % WA30_CELL == 0 and (ty - by) % WA30_CELL == 0:
                cost[i, j] = (abs(bx - tx) + abs(by - ty)) // WA30_CELL
    r, c = linear_sum_assignment(cost)
    tot = int(cost[r, c].sum())
    return None if tot >= BIG else tot


def _wa30_has_enemies(g):
    return any(g.current_level.get_sprites_by_tag(t) for t in WA30_ENEMY_TAGS)


def build_wa30(start_game):
    """wa30 carry-sokoban. win <=> every box cell lies in the target region and no box
    is grabbed. 4px/cell. A box moves only while CARRIED, and a carry advances it exactly
    one cell per player action; enemy-free => uncarried boxes never move. So each box needs
    >= its (grid) distance to a distinct target cell, one carry-move (=one action) apiece =>
    floor >= Hungarian box->target matching. h = that matching; move_bound=1 (one action
    moves at most one box by at most one cell). NOT admissible on enemy levels (enemies move
    boxes mid-step -> caught by the move-bound self-check + explicit enemy guard)."""
    boxes, targ = _wa30_boxes_targets(start_game)
    lb0 = _wa30_matching_lb(boxes, targ)
    ok = lb0 is not None and not _wa30_has_enemies(start_game)

    def h(game):
        b, t = _wa30_boxes_targets(game)
        v = _wa30_matching_lb(b, t)
        return 0 if v is None else v

    return Abstraction("wa30_sokoban_hungarian", h, 1,
                       f"floor >= Hungarian(box->distinct target cell) matching = {lb0} "
                       f"carry-moves ({WA30_CELL}px/cell): each of {len(boxes)} boxes must "
                       "reach a distinct target cell, a carried box advances 1 cell/action "
                       "and (enemy-free) uncarried boxes never move. move_bound=1.",
                       ok=ok, meta={"lb0": lb0, "nb": len(boxes), "nt": len(targ),
                                    "enemies": _wa30_has_enemies(start_game)})


# bp35 gravity-push puzzle (source environment_files/bp35/0a0ad940/bp35.py):
#   available_actions = [3,4,6,7] = move-left / move-right / click / undo.
#   Each move: step sideways one cell (blocked by walls) then FALL under gravity
#   (vivnprldht flips the fall direction; a click on the 'lrpkmzabbfa' button toggles
#   it). Win = enter/land on the exit gem 'fjlzdjxhant'; spikes 'ubhhgljbnpu'/'hzusueifitk'
#   lose. Click (ACTION6) toggles solid<->passable blocks (oonshderxef<->yuuqpmlxorv),
#   spawns blocks (etlsaqqtjvn), teleports (qclfkhjnaac), or flips gravity — a DETERMINISTIC
#   function of the clicked cell. Levels 1-3 also carry a deterministic moving hazard
#   (mylefxfaev raises sprites every even move; player on that row => lose). Everything is a
#   deterministic function of (state, action), so full-state df-pn over whitebox_sig is a
#   SOUND exact-floor search. No clean geometric LB survives gravity-teleport-flip, so we
#   run heuristic-free (ok=False): the LB is the df-pn exhausted-depth bound, the UB the
#   replay-verified route -> honest sandwich unless they collapse.
def build_bp35(start_game):
    return Abstraction(
        "bp35_none", lambda g: 0, 1,
        "no certified geometric LB (gravity + block-toggle + teleport + gravity-flip "
        "clicks defeat every static distance bound); LB = heuristic-free df-pn "
        "exhausted-depth, UB = replay-verified route. Full-state (whitebox_sig) search "
        "is sound because every bp35 transition is deterministic in (state, action).",
        ok=False, meta={"note": "heuristic-free exhaustion; deterministic full-state search"})


def build_cd82(start_game):
    def h(game):
        vstazxqstp = [s for s in game.current_level.get_sprites() if s.name.startswith("eoqnvkspoa-")]
        notymrgpnm = game.current_level.get_sprites_by_name("xytrjjbyib")
        if not vstazxqstp or not notymrgpnm:
            return 0
        optphfbnep = notymrgpnm[0].pixels
        pvdfcqjxfe = vstazxqstp[0].pixels
        poqpfcjieu = np.ones((10, 10), dtype=bool)
        for i in range(10):
            poqpfcjieu[i, i] = False
            poqpfcjieu[i, 9 - i] = False
        diff = int(np.sum((optphfbnep != pvdfcqjxfe) & poqpfcjieu))
        return -(-diff // 55)

    return Abstraction("cd82_octantcover", h, 1,
                       "floor >= ceil(mismatched_px / 55): each action fills at most 55 cells. move_bound=1.",
                       ok=True)


BUILDERS = {"g50t": build_g50t, "dc22": build_dc22,
            "re86": build_re86, "lf52": build_lf52, "wa30": build_wa30,
            "bp35": build_bp35, "cd82": build_cd82}


