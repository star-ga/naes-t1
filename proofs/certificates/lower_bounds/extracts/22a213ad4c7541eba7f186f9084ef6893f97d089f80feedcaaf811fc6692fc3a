# soundness prechecks
# ===========================================================================
def precheck_move_bound(start_z, base_lc, alphabet, absn, samples=400,
                        click_probe=False, hw=(64, 64)):
    """BFS-sample up to `samples` states; for each apply every action and confirm h
    never DROPS by more than move_bound on any edge (consistency). Returns
    (ok, worst_drop, checked). A False disables the abstraction (h=0) BEFORE the search
    so the LB stays sound — e.g. dc22 itki-teleport is caught here."""
    from collections import deque
    seen = {M.whitebox_sig(M.restore(start_z))}
    q = deque([start_z])
    checked = 0
    worst = 0
    while q and checked < samples:
        tape = q.popleft()
        gp = M.restore(tape)
        try:
            ph = absn.h(gp)
        except Exception:  # noqa: BLE001
            return False, 10 ** 9, checked
        checked += 1
        for (a, x, y) in _actions_for(tape, gp, alphabet, click_probe, hw):
            gc = M.restore(tape)
            fd = M.act(gc, a, x, y)
            if M.lc_of(fd) > base_lc:
                continue
            if "GAME_OVER" in str(getattr(fd, "state", "")):
                continue
            try:
                M.frame_of(fd)
                hc = absn.h(gc)
            except Exception:  # noqa: BLE001
                continue
            worst = max(worst, ph - hc)
            if ph - hc > absn.move_bound:
                return False, ph - hc, checked
            ch = M.whitebox_sig(gc)
            if ch not in seen:
                seen.add(ch)
                q.append(tape + ((a, x, y),))
    return True, worst, checked


def verify_win_zero(start_z, route, base_lc, absn):
    """Replay the winning route; confirm h hits 0 exactly at the winning step and never
    drops by > move_bound along it (necessary condition for admissibility)."""
    g = M.restore(start_z)   # single live game stepped forward: O(n), not O(n^2)
    hp = absn.h(g)
    ok_bound = True
    for (a, x, y) in route:
        fd = M.act(g, a, x, y)
        if M.lc_of(fd) > base_lc:
            return (hp <= absn.move_bound), ok_bound  # h just before win <= 1 step
        hc = absn.h(g)
        if hp - hc > absn.move_bound:
            ok_bound = False
        hp = hc
    return False, ok_bound


# real level counts (source-verified; the acquisition cascade also snapshots a
# terminal slot one past the last real level, which we skip).
REAL_LEVELS = {"g50t": 7, "dc22": 6, "re86": 8, "lf52": 10, "wa30": 9, "bp35": 9, "cd82": 6}
# per-game action alphabet (simple actions) + whether clicks must be probed.
# bp35: simple = move-left(3), move-right(4); clicks(6) probed & clustered. ACTION7 is
# UNDO (svmaaixutx pops the saved-state stack to a PREVIOUSLY VISITED state); a shortest
# solution never revisits a state, so undo can never shorten the floor -> omitting it from
# the alphabet is sound and does not raise the proved minimum (it only cuts branching).
GAME_ALPHA = {
    "g50t": ([1, 2, 3, 4, 5], False),
    "re86": [1, 2, 3, 4, 5],
    "dc22": ([1, 2, 3, 4], True),
    "lf52": ([1, 2, 3, 4, 7], True),
    "wa30": ([1, 2, 3, 4, 5], False),
    "bp35": ([3, 4], True),
    "cd82": ([1, 2, 3, 4, 5], True),
}



def route_win_len(start_z, route, base_lc):
    """First prefix length of the recorded route that wins the level (its true within-
    level UB) and whether it replay-verifies. Returns (win_len or None, verified)."""
    g = M.restore(start_z)
    for i, (a, x, y) in enumerate(route, 1):
        fd = M.act(g, a, x, y)
        if M.lc_of(fd) > base_lc:
            return i, M.verify_replay(start_z, list(route[:i]), base_lc)
    return None, False


def prove_level(short, game_id, level, starts, args):
    rec = {"game": game_id, "level": level, "floor": None, "kind": None,
           "method": None, "lower_bound_argument": None, "replay_verified": False,
           "nodes_expanded": 0}
    real = REAL_LEVELS.get(short, 99)
    if level > real:
        rec.update(kind="skip", method=f"level past the last (game has {real} real levels)")
        return rec
    if level not in starts:
        rec.update(kind="error", method="level start not reached by cascade")
        return rec
    st = starts[level]
    if not M.verify_restore_fidelity(st["z"], st["frame"]):
        rec.update(kind="error", method="replay restore diverged from recorded start")
        return rec
    start_z, base_lc, route = st["z"], st["lc"], st["solver_trace"]
    term = str(getattr(M.restore(start_z), "_state", ""))
    if "WIN" in term or "GAME_OVER" in term:
        rec.update(kind="skip", method=f"terminal start snapshot ({term.split('.')[-1]})")
        return rec

    start_game = M.restore(start_z)
    hw = st["frame"].shape
    simple, click_probe = (GAME_ALPHA[short] if isinstance(GAME_ALPHA[short], tuple)
                           else (GAME_ALPHA[short], False))
    if args.no_clicks:
        click_probe = False
    avail = _avail(start_game) or simple
    alphabet = [(a, None, None) for a in simple if a in avail]

    ub_len, ub_verified = route_win_len(start_z, route, base_lc)

    absn = BUILDERS[short](start_game)
    try:
        h0 = absn.h(start_game)
    except Exception as e:  # noqa: BLE001
        absn.ok = False
        h0 = 0
        absn.meta["build_error"] = repr(e)
    # soundness prechecks (simple-action move bound; clicks handled per-game below).
    # Movement games (no click probe) use the fast game-carrying precheck.
    if click_probe:
        pc_ok, worst, checked = precheck_move_bound(
            start_z, base_lc, alphabet, absn, samples=args.precheck,
            click_probe=False, hw=hw)
    else:
        pc_ok, worst, checked = precheck_move_bound_fast(
            start_z, base_lc, alphabet, absn, samples=args.precheck)
    wz_ok, wb_ok = (True, True)
    if ub_len:
        wz_ok, wb_ok = verify_win_zero(start_z, list(route[:ub_len]), base_lc, absn)
    # dc22: the ACTION6 itki-teleport (source: L3-L6) moves the agent >1 cell/action, so
    # manhattan is NOT an admissible floor LB there. Only L1/L2 have no itki pair.
    dc22_itki = (short == "dc22" and level not in (1, 2))
    wa30_enemy = (short == "wa30" and
                  _wa30_has_enemies(start_game))
    admissible = absn.ok and pc_ok and wb_ok and not dc22_itki and not wa30_enemy
    if not admissible:
        h0 = 0  # abstraction not certified here -> no static LB, no h-pruning
        if dc22_itki:
            rec["lower_bound_argument_note"] = (
                "dc22 L3-L6 have ACTION6 itki-teleport (agent jumps >1 cell/action); "
                "manhattan is NOT admissible here -> no static LB claimed")
        if wa30_enemy:
            rec["lower_bound_argument_note"] = (
                "wa30 enemy level (auto-moving sprites relocate boxes mid-step, and can "
                "carry a box onto its target for free) -> the sokoban matching is NOT an "
                "admissible LB on player actions here -> no certified static LB claimed")

    sys.stderr.write(
        f"[prove] {short} L{level} base_lc={base_lc} avail={avail} "
        f"h0={h0} route_ub={ub_len}(verified={ub_verified}) "
        f"absn={absn.name} admissible={admissible} "
        f"(precheck ok={pc_ok} worst_drop={worst}/{absn.move_bound} checked={checked}; "
        f"win_zero={wz_ok} win_bound={wb_ok}) clicks={click_probe}\n")

    rec["lower_bound_argument"] = (absn.argument if admissible else
                                   "no certified admissible abstraction; LB is the "
                                   "heuristic-free df-pn exhausted-depth bound only")

    # -------- INSTANT SANDWICH-COLLAPSE PROOF (no search) --------
    # floor >= h0 (admissible abstraction) and floor <= ub_len (replay-verified route);
    # if h0 == ub_len the sandwich collapses => floor is PROVEN with zero search.
    if admissible and ub_len and ub_verified and h0 == ub_len:
        rec.update(floor=h0, kind="proven",
                   method=f"sandwich collapse: admissible LB h(start)={h0} == "
                          f"replay-verified route UB={ub_len}; no search needed",
                   replay_verified=True, nodes_expanded=0)
        return rec

    # -------- df-pn / IDA* search (skipped in --lb-only) --------
    d_hi = ub_len if ub_len else args.depth_cap
    if admissible and h0 > 0:
        eff_absn = absn
        d_lo = h0
    else:
        eff_absn = Abstraction("h0", lambda g: 0, 1, "no admissible abstraction", ok=False)
        d_lo = 0

    if args.lb_only:
        pr = ProofResult()
        pr.lb = h0 if admissible else 0
        pr.ub = None
    elif click_probe:
        pr = dfpn_floor(start_z, base_lc, alphabet, eff_absn, args.nodes,
                        d_lo, d_hi, click_probe=click_probe, hw=hw)
    else:
        # movement game (no click probe): fast game-carrying IDA* (no per-node replay)
        pr = dfpn_floor_fast(start_z, base_lc, alphabet, eff_absn, args.nodes,
                             d_lo, d_hi, time_budget=args.time_budget)

    rec["nodes_expanded"] = pr.nodes
    # merge lower bounds: certified static h0 + df-pn exhausted-depth
    lb = max(pr.lb, h0 if admissible else 0)
    ub = ub_len if ub_len else pr.ub

    if pr.proven and pr.consistency_ok:
        # exact floor: verify the winning route replays at exactly `floor` on a fresh engine
        verified = M.verify_replay(start_z, pr.path, base_lc)
        # and it must be a true minimum: pr.floor == lb-consistent (df-pn disproved floor-1)
        rec.update(floor=pr.floor, kind="proven",
                   method=f"df-pn/IDA* + {absn.name}; proved P({pr.floor}) & disproved "
                          f"P({pr.floor - 1}); nodes={pr.nodes}",
                   replay_verified=verified)
        rec["min_path"] = [_fmt(ak) for ak in pr.path]
        if not verified:
            rec.update(kind="ub", method=rec["method"] + " [replay FAILED -> downgraded]")
        return rec

    # post-search sandwich COLLAPSE: df-pn disproved every depth < ub (lb == ub) and
    # the route wins at ub => floor == ub is PROVEN even without completing iteration ub.
    if ub and lb == ub and ub_verified and pr.consistency_ok:
        rec.update(floor=int(ub), kind="proven",
                   method=f"df-pn/IDA* disproved P({ub - 1}) (all depths < {ub} exhausted) "
                          f"and route wins at {ub} => floor={ub}; nodes={pr.nodes}",
                   replay_verified=True)
        return rec

    # sandwich (honest): proven LB, verified UB
    method = ("lb-only (abstraction static LB / route UB; no search)" if args.lb_only
              else "df-pn/IDA* budget-truncated" if pr.budget_hit
              else "df-pn/IDA* incomplete")
    if not absn.ok:
        method += " (abstraction fields unresolved)"
    elif not admissible:
        method += f" (abstraction NOT admissible here: precheck drop {worst}>{absn.move_bound})"
    if pr.consistency_violation:
        method += f"; consistency VOID: {pr.consistency_violation}"
    rec.update(floor={"lb": int(lb), "ub": (int(ub) if ub else None)}, kind="ub",
               method=method + f"; nodes={pr.nodes}; iters={pr.iters[-3:]}",
               replay_verified=bool(ub_verified))
    if ub:
        rec["ub_route_len"] = int(ub)
    return rec


def _fmt(ak):
    a, x, y = ak
    return M._NM.get(a, str(a)) + (f"({x},{y})" if x is not None else "")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--game", required=True)
    ap.add_argument("--levels", default="1")
    ap.add_argument("--nodes", type=int, default=3_000_000)
    ap.add_argument("--time-budget", type=int, default=0,
                    help="per-level wall-clock budget (s) for the fast search; on expiry "
                         "the search RETURNS an honest sandwich (deepest exhausted-depth "
                         "LB + route UB) instead of being killed. 0 = unlimited.")
    ap.add_argument("--depth-cap", type=int, default=400)
    ap.add_argument("--precheck", type=int, default=400)
    ap.add_argument("--lb-only", action="store_true",
                    help="skip the df-pn search: report the instant abstraction LB / "
                         "route UB sandwich (and any zero-search collapse proof) only")
    ap.add_argument("--no-clicks", action="store_true",
                    help="disable per-state click probing (movement-only; for click "
                         "games the result is then a restricted-alphabet UB, not a floor)")
    ap.add_argument("--cache-starts", default=None)
    ap.add_argument("--env-dir", default="environment_files")
    ap.add_argument("--json", default=None)
    args = ap.parse_args()

    import arc_agi
    env_dir = args.env_dir if os.path.isabs(args.env_dir) else os.path.join(ROOT, args.env_dir)
    arc = arc_agi.Arcade(operation_mode="offline", environments_dir=env_dir)
    game_id = M.resolve_game_id(arc, args.game)
    levels = [int(x) for x in args.levels.split(",")]

    probe_env = arc.make(game_id)
    probe_env.reset()
    M.init_replay_backend(probe_env._game)

    starts = None
    if args.cache_starts and os.path.exists(args.cache_starts):
        cached = pickle.load(open(args.cache_starts, "rb"))
        if cached.get("game") == game_id and cached.get("fmt") == "tape":
            starts = cached["starts"]
            sys.stderr.write(f"[main] starts from cache: {sorted(starts)}\n")
    if starts is None:
        starts = M.acquire_level_starts(arc, game_id, max_level=max(levels))
        if args.cache_starts:
            pickle.dump({"game": game_id, "fmt": "tape", "starts": starts},
                        open(args.cache_starts, "wb"))

    rows = []
    for lv in levels:
        rows.append(prove_level(args.game, game_id, lv, starts, args))
        sys.stderr.write(f"[level-done] {json.dumps(rows[-1], default=str)}\n")
        if args.json:
            open(args.json, "w").write(json.dumps({"game": game_id, "results": rows},
                                                  indent=2, default=str))
    blob = json.dumps({"game": game_id, "results": rows}, indent=2, default=str)
    print(blob)
    if args.json:
        open(args.json, "w").write(blob)


if __name__ == "__main__":
    main()
