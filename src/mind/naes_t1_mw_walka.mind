// Multi-worker copy of the workspace offsets, the stem tables, the input
// encoding, the stem walk and the head decision of the grouped-sum kernel.
// Entry points: mw_off_ctx, mw_stem_tables4, mw_encode4, mw_stem_lut_o.

fn mw_off_ctx() -> i64 {
    81792
}

fn mw_off_total() -> i64 {
    81920
}

fn mw_stem_tables4(model: i64) -> i64 {
    let lay: i64 = mw_model_layer(model, 0);
    let t: i64 = ld(lay, 4);
    let tabs: i64 = mw_alloc_zero_bytes(mw_off_total());
    if tabs == 0 {
        return 0;
    }
    let mut o: i64 = 0;
    while o < 64 {
        let mut k: i64 = 0;
        while k < 9 {
            let palb: i64 = tabs + off_pal() + (o * 9 + k) * 64;
            let mut c: i64 = 0;
            while c < 16 {
                put_dup16(palb + c, ld(t, (o * 49 + c) * 9 + k));
                put_dup16(palb + 32 + c, ld(t, (o * 49 + 16 + c) * 9 + k));
                c = c + 1;
            }
            let mut a: i64 = 0;
            while a < 8 {
                __mind_store_i8(tabs + off_pact() + (o * 9 + k) * 8 + a, ld(t, (o * 49 + 32 + a) * 9 + k));
                __mind_store_i8(tabs + off_run() + (o * 9 + k) * 8 + a, ld(t, (o * 49 + 41 + a) * 9 + k));
                a = a + 1;
            }
            __mind_store_i8(tabs + off_click() + o * 9 + k, ld(t, (o * 49 + 40) * 9 + k));
            k = k + 1;
        }
        let m: i64 = ld(__mind_load_i64(lay + 40), o);
        let ev: i64 = ld(__mind_load_i64(lay + 48), o);
        let bq: i64 = ld(__mind_load_i64(lay + 56), o);
        let sh: i64 = 0 - ev - 24;
        let mut rd: i64 = 0;
        if sh >= 1 {
            rd = 1 << (sh - 1);
        }
        let pb: i64 = tabs + off_params() + o * 128;
        splat_i64(pb, m);
        splat_i64(pb + 32, rd);
        splat_i64(pb + 64, sh);
        splat_i64(pb + 96, bq);
        o = o + 1;
    }
    let mut g: i64 = 0;
    while g < 4 {
        let msk: i64 = tabs + off_masks() + g * 32;
        let mut b: i64 = 0;
        while b < 32 {
            __mind_store_i8(msk + b, 128);
            b = b + 1;
        }
        __mind_store_i8(msk, g * 4);
        __mind_store_i8(msk + 8, g * 4 + 1);
        __mind_store_i8(msk + 16, g * 4 + 2);
        __mind_store_i8(msk + 24, g * 4 + 3);
        g = g + 1;
    }
    let fx: i64 = tabs + off_fixed();
    splat_i64(fx, 127);
    splat_i64(fx + 32, 0 - 256);
    splat_i64(fx + 64, 45);
    splat_i64(fx + 96, 0 - 45);
    splat_i64(fx + 128, mw_act_limit() - 1);
    tabs
}

fn encode4_rows(planes: i64, rec: i64) -> i64 {
    let mut src: i64 = rec;
    let mut dst: i64 = planes + 67;
    while src < rec + 4096 {
        __mind_ymm_vmovdqu_ld(0, src, 0);
        __mind_ymm_vmovdqu_st(0, dst, 0);
        __mind_ymm_vmovdqu_ld(0, src, 32);
        __mind_ymm_vmovdqu_st(0, dst, 32);
        __mind_ymm_vmovdqu_ld(0, src, 4096);
        __mind_ymm_vmovdqu_st(0, dst, 4356);
        __mind_ymm_vmovdqu_ld(0, src, 4128);
        __mind_ymm_vmovdqu_st(0, dst, 4388);
        src = src + 64;
        dst = dst + 66;
    }
    0
}

fn mw_encode4(planes: i64, rec: i64) -> i64 {
    let n: i64 = 66 * 66;
    let pa: i64 = __mind_load_i8(rec + 8192);
    let pc: i64 = mw_rec_prev_cell(rec);
    let run: i64 = mw_rec_prev_run(rec);
    encode4_rows(planes, rec);
    let mut py: i64 = 0 - 1;
    let mut px: i64 = 0;
    let mut has: i64 = 0;
    if pc >= 0 && pc < 4096 {
        py = pc / 64;
        px = pc - py * 64;
        has = 1;
    }
    __mind_store_i64(planes + n * 5, pa);
    __mind_store_i64(planes + n * 5 + 8, run);
    __mind_store_i64(planes + n * 5 + 16, py);
    __mind_store_i64(planes + n * 5 + 24, px);
    __mind_store_i64(planes + n * 5 + 32, has);
    0
}

fn mw_stem_lut_o(ctx: i64) -> i64 {
    let counts0: i64 = __mind_load_i64(ctx);
    let dst0: i64 = __mind_load_i64(ctx + 8);
    let planes: i64 = __mind_load_i64(ctx + 16);
    let pal: i64 = __mind_load_i64(ctx + 24);
    let spl: i64 = __mind_load_i64(ctx + 32);
    let click: i64 = __mind_load_i64(ctx + 40);
    let py: i64 = __mind_load_i64(ctx + 48);
    let px: i64 = __mind_load_i64(ctx + 56);
    let params: i64 = __mind_load_i64(ctx + 64);
    let masks: i64 = __mind_load_i64(ctx + 72);
    let fx: i64 = __mind_load_i64(ctx + 88);
    let slot: i64 = __mind_load_i64(ctx + 104);
    let has: i64 = __mind_load_i64(ctx + 112);
    let zero: i64 = __mind_load_i64(ctx + 120);
    __mind_ymm_vmovdqu_ld(8, params, 0);
    __mind_ymm_vmovdqu_ld(7, params, 32);
    __mind_ymm_vmovdqu_ld(6, params, 64);
    __mind_ymm_vmovdqu_ld(5, params, 96);
    __mind_ymm_vmovdqu_ld(12, fx, 0);
    __mind_ymm_vmovdqu_ld(11, fx, 32);
    __mind_ymm_vmovdqu_ld(10, fx, 64);
    __mind_ymm_vmovdqu_ld(9, fx, 96);
    __mind_ymm_vmovdqu_ld(13, fx, 128);
    let mut r0: i64 = planes;
    let mut rowp: i64 = counts0;
    while rowp < counts0 + 8192 {
        __mind_ymm_vpsubq_i64x4_r(0, 0, 0);
        __mind_ymm_vpsubq_i64x4_r(1, 1, 1);
        let mut brow: i64 = r0;
        let mut bpal: i64 = pal;
        let mut bsp: i64 = spl;
        while brow < r0 + 198 {
            __mind_ymm_vmovdqu_ld(2, bpal, 0);
            __mind_ymm_vmovdqu_ld(3, bpal, 32);
            __mind_ymm_vpshufb_i8x32_m(4, 2, brow, 0);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 4356);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 2, brow, 32);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 4388);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vmovdqu_ld(3, bsp, 0);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 0);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 32);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vmovdqu_ld(2, bpal, 64);
            __mind_ymm_vmovdqu_ld(3, bpal, 96);
            __mind_ymm_vpshufb_i8x32_m(4, 2, brow, 1);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 4357);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 2, brow, 33);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 4389);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vmovdqu_ld(3, bsp, 32);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 1);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 33);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vmovdqu_ld(2, bpal, 128);
            __mind_ymm_vmovdqu_ld(3, bpal, 160);
            __mind_ymm_vpshufb_i8x32_m(4, 2, brow, 2);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 4358);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 2, brow, 34);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 4390);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            __mind_ymm_vmovdqu_ld(3, bsp, 64);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 2);
            __mind_ymm_vpaddb_i8x32_r(0, 0, 4);
            __mind_ymm_vpshufb_i8x32_m(4, 3, brow, 34);
            __mind_ymm_vpaddb_i8x32_r(1, 1, 4);
            brow = brow + 66;
            bpal = bpal + 192;
            bsp = bsp + 96;
        }
        __mind_ymm_vmovdqu_st(0, rowp, 32);
        __mind_ymm_vmovdqu_st(0, rowp, 0);
        __mind_ymm_vmovdqu_st(0, rowp, 16);
        __mind_ymm_vmovdqu_st(1, rowp, 96);
        __mind_ymm_vmovdqu_st(1, rowp, 64);
        __mind_ymm_vmovdqu_st(1, rowp, 80);
        rowp = rowp + 128;
        r0 = r0 + 66;
    }
    if has == 1 {
        let mut ky2: i64 = 0;
        while ky2 < 3 {
            let yy: i64 = py - ky2 + 1;
            if yy >= 0 && yy < 64 {
                let mut kx2: i64 = 0;
                while kx2 < 3 {
                    let xx: i64 = px - kx2 + 1;
                    if xx >= 0 && xx < 64 {
                        let wb: i64 = __mind_load_i8(click + ky2 * 3 + kx2);
                        let ws: i64 = wb - ((wb >> 7) << 8);
                        let cp: i64 = counts0 + yy * 128 + xx + ((xx >> 4) << 4);
                        let ab: i64 = __mind_load_i8(cp);
                        let asu: i64 = ab - ((ab >> 7) << 8);
                        __mind_store_i8(cp, asu + ws);
                        __mind_store_i8(cp + 16, asu + ws);
                    }
                    kx2 = kx2 + 1;
                }
            }
            ky2 = ky2 + 1;
        }
    }
    __mind_ymm_vmovdqu_ld(4, zero, 0);
    rowp = counts0;
    let mut dst: i64 = dst0;
    while rowp < counts0 + 8192 {
        let mut tile: i64 = 0;
        let mut src: i64 = rowp;
        let mut outp: i64 = dst;
        while tile < 2 {
            let mut half: i64 = 0;
            let mut hbase: i64 = src;
            let mut hp: i64 = outp;
            while half < 2 {
                __mind_ymm_vmovdqu_ld(2, hbase, 0);
                let mut g: i64 = 0;
                let mut mp: i64 = masks;
                let mut dp: i64 = hp;
                while g < 4 {
                    __mind_ymm_vpshufb_i8x32_m(0, 2, mp, 0);
                    __mind_ymm_vpcmpgtq_i64x4_r(1, 0, 12);
                    __mind_ymm_vpand_i64x4_r(1, 1, 11);
                    __mind_ymm_vpor_i64x4_r(0, 0, 1);
                    __mind_ymm_vpcmpgtq_i64x4_r(1, 0, 10);
                    __mind_ymm_vpor_i64x4_r(14, 14, 1);
                    __mind_ymm_vpcmpgtq_i64x4_r(1, 9, 0);
                    __mind_ymm_vpor_i64x4_r(14, 14, 1);
                    __mind_ymm_vpcmpgtq_i64x4_r(3, 4, 0);
                    __mind_ymm_vpand_i64x4_r(1, 0, 3);
                    __mind_ymm_vpsubq_i64x4_r(0, 0, 1);
                    __mind_ymm_vpsubq_i64x4_r(0, 0, 1);
                    __mind_ymm_vpmuludq_i64x4_r(0, 0, 8);
                    __mind_ymm_vpaddq_i64x4_r(0, 0, 7);
                    __mind_ymm_vpsrlq_i64x4_r(0, 0, 6);
                    __mind_ymm_vpand_i64x4_r(1, 0, 3);
                    __mind_ymm_vpsubq_i64x4_r(0, 0, 1);
                    __mind_ymm_vpsubq_i64x4_r(0, 0, 1);
                    __mind_ymm_vpaddq_i64x4_r(0, 0, 5);
                    __mind_ymm_vpcmpgtq_i64x4_r(1, 4, 0);
                    __mind_ymm_vpand_i64x4_r(1, 1, 0);
                    __mind_ymm_vpsubq_i64x4_r(0, 0, 1);
                    __mind_ymm_vpcmpgtq_i64x4_r(1, 0, 13);
                    __mind_ymm_vpor_i64x4_r(14, 14, 1);
                    __mind_ymm_vmovdqu_st(0, dp, 0);
                    mp = mp + 32;
                    dp = dp + 32;
                    g = g + 1;
                }
                hbase = hbase + 32;
                hp = hp + 128;
                half = half + 1;
            }
            src = src + 64;
            outp = outp + 256;
            tile = tile + 1;
        }
        rowp = rowp + 128;
        dst = dst + 768;
    }
    __mind_ymm_vmovdqu_st(14, slot, 0);
    if (__mind_load_i64(slot) | __mind_load_i64(slot + 8) | __mind_load_i64(slot + 16) | __mind_load_i64(slot + 24)) != 0 {
        return 0 - 1;
    }
    0
}

fn decide4_i64(model: i64, w4: i64, rec: i64) -> i64 {
    let ws: i64 = ld(w4, w4_ws());
    let nb: i64 = __mind_load_i64(model + 8);
    let t0: i64 = clock4(w4);
    if mw_stem_phase4(w4, rec) < 0 {
        return 0 - 1;
    }
    let t1: i64 = clock4(w4);
    let mut hin: i64 = ld(ws, ws_ha());
    let mut hout: i64 = ld(ws, ws_hb());
    let mut b: i64 = 0;
    while b < nb {
        if mw_block_phase4(model, w4, b, hin, hout) < 0 {
            return 0 - 1;
        }
        let tmp: i64 = hin;
        hin = hout;
        hout = tmp;
        b = b + 1;
    }
    let t2: i64 = clock4(w4);
    let action: i64 = mw_head_phase4(model, w4, hin);
    let t3: i64 = clock4(w4);
    add_ns(w4, w4_stem_ns(), t1 - t0);
    add_ns(w4, w4_block_ns(), t2 - t1);
    add_ns(w4, w4_head_ns(), t3 - t2);
    action
}

fn mw_decide4(model: i64, w4: i64, rec: i64) -> i64 {
    let p: i64 = p32_state(w4, model);
    if p != 0 {
        let a: i64 = p32_decide(model, w4, p, rec);
        if a >= 1 || a == 0 - 3 {
            return a;
        }
    }
    decide4_i64(model, w4, rec)
}

fn mw_w4_erec() -> i64 { 22 }

fn bank_row(bank: i64, gl: i64, codes: i64, code: i64) -> i64 {
    bank + (gl * codes + code - 1) * bank_row_bytes() + 128
}

fn mw_stem4(ws: i64, tabs: i64, planes: i64, scratch: i64, zero: i64) -> i64 {
    if scratch == 0 || zero == 0 || tabs == 0 {
        return 0 - 1;
    }
    if stem_params_ok(tabs) == 0 {
        return 0 - 1;
    }
    let n: i64 = 66 * 66;
    let pa: i64 = __mind_load_i64(planes + n * 5);
    let run: i64 = __mind_load_i64(planes + n * 5 + 8);
    if pa < 0 || pa > 7 {
        return 0 - 1;
    }
    if run < 0 || run > 7 {
        return 0 - 1;
    }
    stem_fill_splats(tabs, pa, run);
    let h: i64 = ld(ws, ws_ha());
    let ctx: i64 = tabs + mw_off_ctx();
    __mind_store_i64(ctx, tabs + off_counts());
    __mind_store_i64(ctx + 40, 0);
    __mind_store_i64(ctx + 48, __mind_load_i64(planes + n * 5 + 16));
    __mind_store_i64(ctx + 56, __mind_load_i64(planes + n * 5 + 24));
    __mind_store_i64(ctx + 72, tabs + off_masks());
    __mind_store_i64(ctx + 88, tabs + off_fixed());
    __mind_store_i64(ctx + 104, scratch + 64);
    __mind_store_i64(ctx + 112, __mind_load_i64(planes + n * 5 + 32));
    __mind_store_i64(ctx + 120, zero);
    let mut o: i64 = 0;
    while o < 64 {
        __mind_store_i64(ctx + 8, h + (o * plane() + origin()) * 8);
        __mind_store_i64(ctx + 16, planes);
        __mind_store_i64(ctx + 24, tabs + off_pal() + o * 9 * 64);
        __mind_store_i64(ctx + 32, tabs + off_spl() + o * 9 * 32);
        __mind_store_i64(ctx + 40, tabs + off_click() + o * 9);
        __mind_store_i64(ctx + 64, tabs + off_params() + o * 128);
        if mw_stem_lut_o(ctx) != 0 {
            return 0 - 1;
        }
        o = o + 1;
    }
    0
}

fn mw_reduce4(k: i64, dir: i64) -> i64 {
    let mut best_i: i64 = __mind_load_i64(k + 96);
    let mut best_s: i64 = dir * __mind_load_i64(k + 64);
    let mut col: i64 = 1;
    while col < 4 {
        let s: i64 = dir * __mind_load_i64(k + 64 + col * 8);
        let ix: i64 = __mind_load_i64(k + 96 + col * 8);
        if s > best_s {
            best_s = s;
            best_i = ix;
        }
        if s == best_s {
            if ix < best_i {
                best_i = ix;
            }
        }
        col = col + 1;
    }
    best_i
}
