// naes_t1_weights.mind — load and validate a NAES-T1 weights file.
// Byte layout: see WEIGHTS_FORMAT.md. Every check fails closed with a
// negative code; a model is returned only when the whole file is consistent.
//
// Layer record (heap, i64 fields):
//   +0 out  +8 in  +16 k  +24 dilation
//   +32 tern  (i64[out*in*k*k], values -1/0/+1, (O,C,kh,kw) order)
//   +40 scale mantissa  (i64[out])   +48 scale exponent (i64[out])
//   +56 bias in Q24     (i64[out])
//
// Model record (heap, i64 fields):
//   +0 channels  +8 residual blocks  +16 layer table (i64[n_layers] of records)

// Input planes of layer 0: cur colour 16, prev colour 16, prev action 8,
// prev click 1, prev run length 8 (in that order).
pub fn n_in() -> i64 {
    49
}

// Error codes returned by load_model (negative).
pub fn err_io() -> i64 {
    0 - 1
}
pub fn err_header() -> i64 {
    0 - 2
}
pub fn err_shape() -> i64 {
    0 - 3
}
pub fn err_size() -> i64 {
    0 - 4
}
pub fn err_value() -> i64 {
    0 - 5
}

// Read everything from `fd` into a growing heap buffer. Stores the buffer at
// rec+0 and the length at rec+8. Returns 0, or -1 on a read error.
fn read_fd_all(fd: i64, rec: i64) -> i64 {
    let mut cap: i64 = 1048576;
    let mut buf: i64 = __mind_alloc(cap);
    let mut got: i64 = 0;
    let mut done: i64 = 0;
    while done == 0 {
        if buf == 0 {
            return 0 - 1;
        }
        if got == cap {
            cap = cap * 2;
            buf = __mind_realloc(buf, cap);
        } else {
            let n: i64 = __mind_read(fd, buf + got, cap - got, 0 - 1);
            if n < 0 {
                return 0 - 1;
            }
            if n == 0 {
                done = 1;
            }
            got = got + n;
        }
    }
    __mind_store_i64(rec, buf);
    __mind_store_i64(rec + 8, got);
    0
}

fn rd_u32(buf: i64, off: i64) -> i64 {
    __mind_load_i32(buf + off)
}

// Magic "NAEST1WB" as the little-endian u64 0x425731545345414E.
fn magic_ok(buf: i64) -> i64 {
    if rd_u32(buf, 0) != 1397047630 {
        return 0;
    }
    if rd_u32(buf, 4) != 1113010516 {
        return 0;
    }
    1
}

// Expected (out, in, k) of layer i given channels and layer count; dilation
// is checked separately. Returns 1 when the descriptor matches.
fn shape_ok(i: i64, n: i64, ch: i64, out: i64, inp: i64, k: i64, dil: i64) -> i64 {
    let mut want_out: i64 = ch;
    let mut want_in: i64 = ch;
    let mut want_k: i64 = 3;
    let mut max_dil: i64 = 16;
    if i == 0 {
        want_in = n_in();
        max_dil = 1;
    }
    if i == n - 2 {
        want_out = 7;
        want_in = 2 * ch;
        want_k = 1;
        max_dil = 1;
    }
    if i == n - 1 {
        want_out = 1;
        want_k = 1;
        max_dil = 1;
    }
    if out != want_out || inp != want_in || k != want_k {
        return 0;
    }
    let mut want_dil: i64 = 1;
    if i == 2 || i == 7 { want_dil = 2; }
    if i == 3 || i == 8 { want_dil = 4; }
    if i == 4 { want_dil = 8; }
    if i == 5 { want_dil = 16; }
    if dil != want_dil {
        return 0;
    }
    1
}

// Decode the ternary bytes of one layer into an i64 array. 0 on success.
fn load_tern(buf: i64, off: i64, cnt: i64, dst: i64) -> i64 {
    let mut j: i64 = 0;
    while j < cnt {
        let b: i64 = __mind_load_i8(buf + off + j);
        let mut t: i64 = 0;
        if b == 1 {
            t = 1;
        } else {
            if b == 255 {
                t = 0 - 1;
            } else {
                if b != 0 {
                    return 0 - 1;
                }
            }
        }
        __mind_store_i64(dst + j * 8, t);
        j = j + 1;
    }
    0
}

// Decode `out` scales and biases. Scale must satisfy |s| < 2^8 (exponent
// e <= -16 or zero mantissa) and bias |b| < 2^16 (e <= -8 or zero).
fn load_scale_bias(buf: i64, off: i64, out: i64, lay: i64) -> i64 {
    let ms: i64 = __mind_alloc(out * 8);
    let es: i64 = __mind_alloc(out * 8);
    let bq: i64 = __mind_alloc(out * 8);
    let tmp: i64 = __mind_alloc(16);
    let mut o: i64 = 0;
    while o < out {
        if f32_decode(rd_u32(buf, off + o * 4), tmp) < 0 {
            return 0 - 1;
        }
        let sm: i64 = __mind_load_i64(tmp);
        let se: i64 = __mind_load_i64(tmp + 8);
        if sm != 0 && se > 0 - 16 {
            return 0 - 1;
        }
        __mind_store_i64(ms + o * 8, sm);
        __mind_store_i64(es + o * 8, se);
        if f32_decode(rd_u32(buf, off + out * 4 + o * 4), tmp) < 0 {
            return 0 - 1;
        }
        let bm: i64 = __mind_load_i64(tmp);
        let be: i64 = __mind_load_i64(tmp + 8);
        if bm != 0 && be > 0 - 8 {
            return 0 - 1;
        }
        __mind_store_i64(bq + o * 8, to_q24(bm, be));
        o = o + 1;
    }
    __mind_store_i64(lay + 40, ms);
    __mind_store_i64(lay + 48, es);
    __mind_store_i64(lay + 56, bq);
    0
}

// Parse a whole weights image. Returns a model record address (> 0) or a
// negative error code.
pub fn parse_model(buf: i64, len: i64) -> i64 {
    if len < 16 {
        return err_header();
    }
    if rd_u32(buf, 0) == 1397047630 && rd_u32(buf, 4) == 5714260 {
        return parse_named_model(buf, len);
    }
    if magic_ok(buf) == 0 || rd_u32(buf, 8) != 1 {
        return err_header();
    }
    let n: i64 = rd_u32(buf, 12);
    if n != 11 || len < 16 + n * 16 {
        return err_header();
    }
    let ch: i64 = rd_u32(buf, 16);
    if ch != 64 {
        return err_shape();
    }
    let layers: i64 = __mind_alloc(n * 8);
    let mut off: i64 = 16 + n * 16;
    let mut i: i64 = 0;
    while i < n {
        let d: i64 = 16 + i * 16;
        let out: i64 = rd_u32(buf, d);
        let inp: i64 = rd_u32(buf, d + 4);
        let k: i64 = rd_u32(buf, d + 8);
        let dil: i64 = rd_u32(buf, d + 12);
        if shape_ok(i, n, ch, out, inp, k, dil) == 0 {
            return err_shape();
        }
        let cnt: i64 = out * inp * k * k;
        let tpad: i64 = ((cnt + 3) / 4) * 4;
        if off + tpad + out * 8 > len {
            return err_size();
        }
        let lay: i64 = __mind_alloc(64);
        let tern: i64 = __mind_alloc(cnt * 8);
        __mind_store_i64(lay, out);
        __mind_store_i64(lay + 8, inp);
        __mind_store_i64(lay + 16, k);
        __mind_store_i64(lay + 24, dil);
        __mind_store_i64(lay + 32, tern);
        if load_tern(buf, off, cnt, tern) < 0 {
            return err_value();
        }
        if load_scale_bias(buf, off + tpad, out, lay) < 0 {
            return err_value();
        }
        __mind_store_i64(layers + i * 8, lay);
        off = off + tpad + out * 8;
        i = i + 1;
    }
    if off != len {
        return err_size();
    }
    let model: i64 = __mind_alloc(24);
    __mind_store_i64(model, ch);
    __mind_store_i64(model + 8, n - 3);
    __mind_store_i64(model + 16, layers);
    model
}

// Open and parse the weights file at a NUL-terminated path.
pub fn load_model(path: i64) -> i64 {
    let fd: i64 = __mind_open(path);
    if fd < 0 {
        return err_io();
    }
    let rec: i64 = __mind_alloc(16);
    if read_fd_all(fd, rec) < 0 {
        return err_io();
    }
    parse_model(__mind_load_i64(rec), __mind_load_i64(rec + 8))
}

pub fn model_layer(model: i64, i: i64) -> i64 {
    __mind_load_i64(__mind_load_i64(model + 16) + i * 8)
}

// Accept the reference's named, interleaved NAEST1W image as well as NAEST1WB.
fn layer_name_ok(buf: i64, off: i64, size: i64, name: String) -> i64 {
    if size != name.len { return 0; }
    let mut j: i64 = 0;
    while j < size {
        if __mind_load_i8(buf + off + j) != __mind_load_i8(name.addr + j) { return 0; }
        j = j + 1;
    }
    1
}

fn expected_layer_name(buf: i64, off: i64, size: i64, i: i64) -> i64 {
    if i == 0 { return layer_name_ok(buf, off, size, "inp"); }
    if i == 1 { return layer_name_ok(buf, off, size, "blocks.0"); }
    if i == 2 { return layer_name_ok(buf, off, size, "blocks.1"); }
    if i == 3 { return layer_name_ok(buf, off, size, "blocks.2"); }
    if i == 4 { return layer_name_ok(buf, off, size, "blocks.3"); }
    if i == 5 { return layer_name_ok(buf, off, size, "blocks.4"); }
    if i == 6 { return layer_name_ok(buf, off, size, "blocks.5"); }
    if i == 7 { return layer_name_ok(buf, off, size, "blocks.6"); }
    if i == 8 { return layer_name_ok(buf, off, size, "blocks.7"); }
    if i == 9 { return layer_name_ok(buf, off, size, "act_head"); }
    if i == 10 { return layer_name_ok(buf, off, size, "click_head"); }
    0
}

fn parse_named_model(buf: i64, len: i64) -> i64 {
    if rd_u32(buf, 8) != 1 || rd_u32(buf, 12) != 11 { return err_header(); }
    let layers: i64 = __mind_alloc(88);
    let mut off: i64 = 16;
    let mut i: i64 = 0;
    while i < 11 {
        if off + 4 > len { return err_size(); }
        let size: i64 = rd_u32(buf, off);
        off = off + 4;
        if size < 1 || size > 32 || off + size + 20 > len { return err_size(); }
        if expected_layer_name(buf, off, size, i) == 0 { return err_header(); }
        off = off + size;
        let out: i64 = rd_u32(buf, off);
        let inp: i64 = rd_u32(buf, off + 4);
        let kh: i64 = rd_u32(buf, off + 8);
        let kw: i64 = rd_u32(buf, off + 12);
        let dil: i64 = rd_u32(buf, off + 16);
        off = off + 20;
        if kh != kw || shape_ok(i, 11, 64, out, inp, kh, dil) == 0 { return err_shape(); }
        let cnt: i64 = out * inp * kh * kw;
        if off + cnt + out * 8 > len { return err_size(); }
        let lay: i64 = __mind_alloc(64);
        let tern: i64 = __mind_alloc(cnt * 8);
        __mind_store_i64(lay, out);
        __mind_store_i64(lay + 8, inp);
        __mind_store_i64(lay + 16, kh);
        __mind_store_i64(lay + 24, dil);
        __mind_store_i64(lay + 32, tern);
        if load_tern(buf, off, cnt, tern) < 0 { return err_value(); }
        if load_scale_bias(buf, off + cnt, out, lay) < 0 { return err_value(); }
        __mind_store_i64(layers + i * 8, lay);
        off = off + cnt + out * 8;
        i = i + 1;
    }
    if off != len { return err_size(); }
    let model: i64 = __mind_alloc(24);
    __mind_store_i64(model, 64);
    __mind_store_i64(model + 8, 8);
    __mind_store_i64(model + 16, layers);
    model
}
