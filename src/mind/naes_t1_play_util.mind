// naes_t1_play_util.mind — shared helpers for the NAES-T1 play client.
//
// Buffer builder and string/number helpers; the libc externs live in
// naes_t1_libc.mind. All helpers are prefixed play_ (0.10.4 rule); no
// helper is named like a std seed symbol; no alloc/free runs inside a loop.
fn play_ptr(s: String) -> i64 { s.addr }
fn play_response_cap() -> i64 { 16793600 }
fn play_body_cap() -> i64 { 16777216 }
fn play_len(p: i64) -> i64 {
    if p == 0 { return 0; }
    let mut n: i64 = 0;
    while n < 4096 {
        if __mind_load_i8(p + n) == 0 { return n; }
        n = n + 1;
    }
    0 - 1
}
fn play_copy(dst: i64, src: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n { __mind_store_i8(dst + i, __mind_load_i8(src + i)); i = i + 1; }
    n
}
// Bounded builder [data,len,capacity]. No per-frame heap allocation.
fn play_buf(cap: i64) -> i64 {
    let b: i64 = alloc_zero(3);
    __mind_store_i64(b, __mind_alloc(cap));
    __mind_store_i64(b + 16, cap);
    b
}
fn play_add(b: i64, p: i64, n: i64) -> i64 {
    let len: i64 = __mind_load_i64(b + 8);
    if n < 0 || len < 0 || len + n > __mind_load_i64(b + 16) { __mind_store_i64(b + 8, 0 - 1); return 0; }
    let _c: i64 = play_copy(__mind_load_i64(b) + len, p, n);
    __mind_store_i64(b + 8, len + n);
    1
}
fn play_lit(b: i64, s: String) -> i64 { play_add(b, s.addr, s.len) }
fn play_num(b: i64, n: i64) -> i64 {
    if n < 0 { return 0; }
    let mut v: i64 = n;
    let mut d: i64 = 1;
    while v / d > 9 { d = d * 10; }
    while d > 0 {
        let byte: i64 = 48 + (v / d) % 10;
        let pos: i64 = __mind_load_i64(b + 8);
        if pos < 0 || pos >= __mind_load_i64(b + 16) { return 0; }
        __mind_store_i8(__mind_load_i64(b) + pos, byte);
        __mind_store_i64(b + 8, pos + 1);
        d = d / 10;
    }
    1
}
fn play_safe_id(p: i64, n: i64) -> i64 {
    if n < 1 || n > 255 { return 0; }
    let mut i: i64 = 0;
    while i < n {
        let c: i64 = __mind_load_i8(p + i);
        if !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 || c == 46) { return 0; }
        i = i + 1;
    }
    1
}
fn play_eq(p: i64, n: i64, s: String) -> i64 {
    if n != s.len { return 0; }
    let mut i: i64 = 0;
    while i < n { if __mind_load_i8(p + i) != __mind_load_i8(s.addr + i) { return 0; } i = i + 1; }
    1
}
fn play_lower(c: i64) -> i64 { if c >= 65 && c <= 90 { return c + 32; } c }
fn play_ci(p: i64, n: i64, s: String) -> i64 {
    if n != s.len { return 0; }
    let mut i: i64 = 0;
    while i < n { if play_lower(__mind_load_i8(p + i)) != play_lower(__mind_load_i8(s.addr + i)) { return 0; } i = i + 1; }
    1
}
fn play_uint(p: i64, n: i64) -> i64 {
    if n < 1 || n > 9 { return 0 - 1; }
    let mut i: i64 = 0;
    let mut v: i64 = 0;
    while i < n { let c: i64 = __mind_load_i8(p + i); if c < 48 || c > 57 { return 0 - 1; } v = v * 10 + c - 48; i = i + 1; }
    v
}
fn play_same_cstr(a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 256 {
        let ca: i64 = __mind_load_i8(a + i);
        let cb: i64 = __mind_load_i8(b + i);
        if ca != cb { return 0; }
        if ca == 0 { return 1; }
        i = i + 1;
    }
    0
}
