// naes_t1_libc.mind — the one libc extern surface of the NAES-T1 play client.
//
// Every libc function the play client and the default-backend DNS transport
// (naes_t1_dns_udp.mind) call is declared here once; no other file in the
// play unit declares one of these. The weights loader keeps its own readlink.
// sendto / recvfrom / bind / getsockname serve the DNS selftest's socket case
// (naes_t1_dns_test_udp.mind); listen / getsockopt serve the HTTPS transport
// test (naes_t1_play_tls_test.mind). The socket family is default-backend only: the
// native lane has no rows for it, so the native DNS test unit leaves this
// file out and links naes_t1_dns_udp_stub.mind and
// naes_t1_dns_test_udp_stub.mind instead.
extern "C" {
    unsafe fn socket(domain: i32, type_: i32, protocol: i32) -> i32;
    unsafe fn connect(sockfd: i32, addr: *const u8, addrlen: i32) -> i32;
    unsafe fn bind(sockfd: i32, addr: *const u8, addrlen: i32) -> i32;
    unsafe fn getsockname(sockfd: i32, addr: *mut u8, addrlen: *mut u8) -> i32;
    unsafe fn send(sockfd: i32, buf: *const u8, len: i64, flags: i32) -> i64;
    unsafe fn recv(sockfd: i32, buf: *mut u8, len: i64, flags: i32) -> i64;
    unsafe fn sendto(sockfd: i32, buf: *const u8, len: i64, flags: i32, dest_addr: *const u8, addrlen: i32) -> i64;
    unsafe fn recvfrom(sockfd: i32, buf: *mut u8, len: i64, flags: i32, src_addr: *mut u8, addrlen: *mut u8) -> i64;
    unsafe fn close(fd: i32) -> i32;
    unsafe fn inet_pton(af: i32, src: *const u8, dst: *mut u8) -> i32;
    unsafe fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: *const u8, optlen: i32) -> i32;
    unsafe fn getenv(name: *const u8) -> *const u8;
    unsafe fn creat(path: *const u8, mode: i32) -> i32;
    unsafe fn poll(fds: *mut u8, nfds: i64, timeout_ms: i32) -> i32;
    unsafe fn listen(sockfd: i32, backlog: i32) -> i32;
    unsafe fn getsockopt(sockfd: i32, level: i32, optname: i32, optval: *mut u8, optlen: *mut u8) -> i32;
}
