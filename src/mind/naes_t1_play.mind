            if play_game_ok(response, __mind_load_i64(s + 32), game) == 0 || play_parse(response, __mind_load_i64(s + 32), state, rec) == 0 { code = 8; let _e: i64 = print_text(2, "naes_t1: malformed play response\n"); running = 0; }
            else {
