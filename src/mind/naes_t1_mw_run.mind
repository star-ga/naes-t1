// Group start and stop stubs, the timed plan batches, the output helpers and
// the stream file writer of the multi-worker bench path.
// Entry points: put_sp_sc, put_dec, team_start4.

fn put_sp_sc(fd: i64, sc: i64) -> i64 {
    __mind_store_i8(sc, 32);
    write_fd_all(fd, sc, 1)
}

fn put_dec(fd: i64, sc: i64, v: i64) -> i64 {
    let b: i64 = sc + 16;
    let mut n: i64 = v;
    let mut end: i64 = 24;
    if n < 0 {
        n = 0 - n;
    }
    if n == 0 {
        end = 23;
        __mind_store_i8(b + 23, 48);
    }
    while n > 0 {
        end = end - 1;
        __mind_store_i8(b + end, 48 + (n % 10));
        n = n / 10;
    }
    if v < 0 {
        end = end - 1;
        __mind_store_i8(b + end, 45);
    }
    write_fd_all(fd, b + end, 24 - end)
}

fn team_start4(model: i64, w4: i64, t: i64, timing: i64, full: i64) -> i64 {
    if t != 1 || model <= 0 || w4 == 0 || timing < 0 || full < 0 {
        return 0 - 1;
    }
    0
}

fn team_stop4(tm: i64, model: i64, failed: i64) -> i64 {
    if tm < 0 || model <= 0 {
        return 8;
    }
    failed
}

fn write_stream_file(path: i64, out: i64, n: i64) -> i64 {
    let fd: i64 = __mind_sys_openat(0 - 100, path, 577, 420);
    if fd < 0 {
        return 0 - 1;
    }
    let rc: i64 = write_fd_all(fd, out, n);
    close_fd(fd);
    rc
}

fn plan_timed() -> i64 { 1500 }

// Position step of the timed batches. Constant 1.
fn plan_adv() -> i64 { 1 }

fn plan_span(timed: i64, n: i64) -> i64 {
    if timed != 1 {
        return 0;
    }
    if n < plan_timed() {
        return n;
    }
    plan_timed()
}

fn plan_run(mc: i64, buf: i64, tsb: i64, smp: i64, nb: i64) -> i64 {
    let tk: i64 = mw_alloc_zero(pull_batch());
    if tk == 0 {
        return 1;
    }
    let mut k: i64 = 0;
    let mut b: i64 = 0;
    while k < nb {
        let mut m: i64 = pull_batch();
        if k + m > nb {
            m = nb - k;
        }
        let mut j: i64 = 0;
        while j < m {
            st(tk, j, rot_tok(pull_token(k + j * plan_adv())));
            j = j + 1;
        }
        let ts: i64 = pull_clock(tsb);
        if mig_post(mc, tk, m) < 0 {
            return 1;
        }
        if pull_read(mc, buf, m) != 0 {
            return 1;
        }
        st(smp, b, pull_clock(tsb) - ts);
        b = b + 1;
        k = k + m;
    }
    0
}
