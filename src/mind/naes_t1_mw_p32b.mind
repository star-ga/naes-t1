fn p32_narrow_chan(src: i64, dst: i64, k: i64) -> i64 {
    __mind_ymm_vmovdqu_ld(13, k, 224);
    __mind_ymm_vmovdqu_ld(14, k, 256);
    __mind_ymm_vmovdqu_ld(12, k, 288);
    __mind_ymm_vpsubq_i64x4_r(4, 4, 4);
    let mut s: i64 = src;
    let mut d: i64 = dst;
    let e: i64 = dst + 16384;
    while d < e {
        let mut c: i64 = 0;
        while c < 512 {
            __mind_ymm_vmovdqu_ld(0, s + c, 0);
            __mind_ymm_vmovdqu_ld(1, s + c, 16);
            __mind_ymm_vmovdqu_ld(2, s + c, 32);
            __mind_ymm_vpor_i64x4_r(4, 4, 0);
            __mind_ymm_vpor_i64x4_r(4, 4, 2);
            __mind_ymm_vpshufb_i8x32_r(0, 0, 13);
            __mind_ymm_vpshufb_i8x32_r(1, 1, 14);
            __mind_ymm_vpshufb_i8x32_r(2, 2, 12);
            __mind_ymm_vpor_i64x4_r(0, 0, 1);
            __mind_ymm_vpor_i64x4_r(0, 0, 2);
            __mind_ymm_vmovdqu_st(0, d, 0);
            d = d + 32;
            c = c + 64;
        }
        s = s + 768;
    }
    __mind_ymm_vmovdqu_st(4, k, 416);
    0
}

fn p32_pool_o(s: i64, pp: i64, heat: i64, w: i64) -> i64 {
    __mind_ymm_vmovdqu_ld(0, pp, 0);
    __mind_ymm_vmovdqu_ld(1, pp, 32);
    let mut q: i64 = 0;
    if w == 1 {
        while q < 512 {
            __mind_ymm_vmovdqu_ld(2, s + q, 0);
            __mind_ymm_vpaddq_i64x4_r(0, 0, 2);
            __mind_ymm_vpcmpgtq_i64x4_r(3, 2, 1);
            __mind_ymm_vpsubq_i64x4_r(4, 2, 1);
            __mind_ymm_vpand_i64x4_r(4, 4, 3);
            __mind_ymm_vpaddq_i64x4_r(1, 1, 4);
            __mind_ymm_vpaddq_i64x4_m(2, heat + q, 0);
            __mind_ymm_vmovdqu_st(2, heat + q, 0);
            q = q + 32;
        }
    } else {
        if w == 0 - 1 {
            while q < 512 {
                __mind_ymm_vmovdqu_ld(2, s + q, 0);
                __mind_ymm_vpaddq_i64x4_r(0, 0, 2);
                __mind_ymm_vpcmpgtq_i64x4_r(3, 2, 1);
                __mind_ymm_vpsubq_i64x4_r(4, 2, 1);
                __mind_ymm_vpand_i64x4_r(4, 4, 3);
                __mind_ymm_vpaddq_i64x4_r(1, 1, 4);
                __mind_ymm_vmovdqu_ld(5, heat + q, 0);
                __mind_ymm_vpsubq_i64x4_r(5, 5, 2);
                __mind_ymm_vmovdqu_st(5, heat + q, 0);
                q = q + 32;
            }
        } else {
            while q < 512 {
                __mind_ymm_vmovdqu_ld(2, s + q, 0);
                __mind_ymm_vpaddq_i64x4_r(0, 0, 2);
                __mind_ymm_vpcmpgtq_i64x4_r(3, 2, 1);
                __mind_ymm_vpsubq_i64x4_r(4, 2, 1);
                __mind_ymm_vpand_i64x4_r(4, 4, 3);
                __mind_ymm_vpaddq_i64x4_r(1, 1, 4);
                q = q + 32;
            }
        }
    }
    __mind_ymm_vmovdqu_st(0, pp, 0);
    __mind_ymm_vmovdqu_st(1, pp, 32);
    0
}

fn p32_slot(y: i64, dil: i64) -> i64 {
    if p32_force_ring2() == 1 {
        return (y / dil) % 2;
    }
    (y / dil) % 3
}

fn p32_block(w4: i64, p: i64, lay: i64, plan: i64, b: i64, last: i64) -> i64 {
    let desc: i64 = ld(w4, w4_desc());
    if desc == 0 {
        return 0 - 2;
    }
    let mut lim: i64 = p32_lim();
    if last == 1 {
        lim = mw_act_limit() - 1;
    }
    __mind_store_i64(desc + 80, lim);
    let rc: i64 = p32_block_run(w4, p, lay, plan, last, desc);
    __mind_store_i64(desc + 80, mw_act_limit() - 1);
    rc
}

fn p32_finish(w4: i64, p: i64, sb: i64, y: i64, last: i64) -> i64 {
    if last == 0 {
        return p32_narrow_rows(sb, ld(p, 1) + y * p32_rs(), ld(p, 3));
    }
    let heat: i64 = ld(ld(w4, w4_ws()), ws_acc()) + y * 512;
    zero_i64(heat, 64);
    let pool: i64 = ld(p, 9);
    let wts: i64 = ld(p, 11);
    let mut o: i64 = 0;
    while o < 64 {
        p32_pool_o(sb + o * 512, pool + o * 64, heat, ld(wts, o));
        o = o + 1;
    }
    0
}
