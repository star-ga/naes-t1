// naes_t1_play_tls.mind — HTTPS transport for the NAES-T1 play client.
//
// DNS by naes_t1_dns, TLS by std.https's bounded TLS 1.3 client. No
// getaddrinfo, no std/dns: the host is resolved with naes_dns_resolve and the
// TCP connection is opened on the resolved address. The HTTP/1.1 request is
// built here and the response is framed with the same Content-Length contract
// the play loop expects.
//
// This file: the CA anchors (parsed once, kept in a caller cell), the TLS
// session driver for one request-response, and naes_https_take, which copies
// the body into the session buffer (the play loop's body pointer and length
// contract) and releases the response with https_free. Connections, request
// bytes and keep-alive: naes_t1_play_https.mind; TCP: naes_t1_play_tcp.mind.
import std.tls13_client_core;
import std.tls13_client_hello;
import std.tls13_client_api;
import std.https;
import std.https_http1;
import std.https_io;
import std.https_url;
import std.entropy;
import std.x509_bundle;
import std.x509_path;

// ---- anchor wire ------------------------------------------------------------
// u32be count, then per anchor: u32be len + DER. Returns a 16-byte record
// {addr, len} as tls13c_init expects.
fn naes_tls_anchor_wire(blob: i64) -> i64 {
    let count: i64 = __mind_load_i64(blob);
    let mut total: i64 = 4;
    let mut i: i64 = 0;
    while i < count {
        total = total + 4 + x509_blob_len(blob, i);
        i = i + 1;
    }
    let w: i64 = __mind_alloc(total);
    if w == 0 { return 0; }
    tls13c_put_be16(w, (count >> 16) & 65535);
    tls13c_put_be16(w + 2, count & 65535);
    let mut p: i64 = 4;
    i = 0;
    while i < count {
        let n: i64 = x509_blob_len(blob, i);
        tls13c_put_be16(w + p, (n >> 16) & 65535);
        tls13c_put_be16(w + p + 2, n & 65535);
        tls13c_copy(w + p + 4, blob + x509_blob_off(blob, i), n);
        p = p + 4 + n;
        i = i + 1;
    }
    let rec: i64 = __mind_alloc(16);
    if rec == 0 { return 0; }
    __mind_store_i64(rec, w);
    __mind_store_i64(rec + 8, total);
    rec
}
// The CA anchor wire record: loaded from the default bundle path, then the
// RHEL/Alma path. With a non-zero `cell` the record is kept there and
// loaded once (one parse per game, not per action). Returns the record, -7
// when no bundle loads, or -1.
fn naes_tls_anchors(cell: i64) -> i64 {
    if cell != 0 { if __mind_load_i64(cell) != 0 { return __mind_load_i64(cell); } }
    // 0 = the default path (hio_load_anchors frees its own path buffer)
    let mut blob: i64 = hio_load_anchors(0);
    if blob < 0 {
        let rhel_path: i64 = __mind_alloc(64);
        if rhel_path != 0 {
            let _rp: i64 = naes_tls_copy_lit(rhel_path, "/etc/pki/tls/certs/ca-bundle.crt");
            __mind_store_i8(rhel_path + 32, 0);
            blob = hio_load_anchors(rhel_path);
            __mind_free(rhel_path);
        }
    }
    if blob < 0 { return 0 - 7; }
    let wire: i64 = naes_tls_anchor_wire(blob);
    __mind_free(blob);
    if wire == 0 { return 0 - 1; }
    if cell != 0 { __mind_store_i64(cell, wire); }
    wire
}
// Release a record naes_tls_anchors returned for this call only (cell == 0).
fn naes_tls_anchors_done(cell: i64, wire: i64) -> i64 {
    if cell == 0 { return naes_tls_anchors_free(0, wire); }
    0
}
// Free the anchor record (`wire`, or the one kept in `cell` when wire == 0)
// and clear the cell.
fn naes_tls_anchors_free(cell: i64, wire: i64) -> i64 {
    let mut w: i64 = wire;
    if w == 0 && cell != 0 { w = __mind_load_i64(cell); }
    if w > 0 { __mind_free(__mind_load_i64(w)); __mind_free(w); }
    if cell != 0 { __mind_store_i64(cell, 0); }
    0
}
// Take an hx response record from naes_https_roundtrip: store the status at
// status_cell, copy a body of at most `cap` bytes into buf (its length at
// len_cell) and the first Set-Cookie pair (at most 2048 bytes) into
// cookie_buf (its length at cookie_cell), then release the record with
// https_free, its 8 MiB raw buffer included. Returns 1 for a 2xx body,
// 0 - 2 for another status, 0 - 1 when there is no usable response.
fn naes_https_take(r: i64, buf: i64, cap: i64, status_cell: i64, len_cell: i64, cookie_buf: i64, cookie_cell: i64) -> i64 {
    if r <= 0 { __mind_store_i64(status_cell, 0); return 0 - 1; }
    let status: i64 = https_status(r);
    __mind_store_i64(status_cell, status);
    let blen: i64 = https_body_len(r);
    let mut rc: i64 = 1;
    if https_error(r) != 0 || blen < 0 || blen > cap { rc = 0 - 1; }
    if rc == 1 {
        let _g: i64 = naes_tls_copy(buf, https_body_addr(r), blen);
        __mind_store_i64(len_cell, blen);
        let pair: i64 = https_set_cookie_pair(r, 0);
        if pair != 0 {
            let n: i64 = __mind_load_i64(pair + 8);
            if n > 0 && n <= 2048 { let _c: i64 = naes_tls_copy(cookie_buf, __mind_load_i64(pair), n); __mind_store_i64(cookie_cell, n); }
            __mind_free(pair);
        }
        if status < 200 || status > 299 { rc = 0 - 2; }
    }
    let _f: i64 = https_free(r);
    rc
}
// ---- TLS session driver -----------------------------------------------------
// Flush pending TLS output records to the fd. Returns 0 or a negative code.
fn naes_tls_flush(state: i64, fd: i64, buf: i64) -> i64 {
    let mut rc: i64 = 0;
    while rc == 0 && tls13c_out_pending(state) > 0 {
        let n: i64 = tls13c_read_out(state, buf, 16640);
        if n <= 0 {
            rc = 0 - 1;
        } else {
            let mut sent: i64 = 0;
            while sent < n {
                let w: i64 = (send(fd as i32, (buf + sent) as *const u8, n - sent, 16384 as i32)) as i64;
                if w <= 0 { rc = 0 - 1; sent = n; } else { sent = sent + w; }
            }
        }
    }
    rc
}
// Read some bytes from the fd into buf (at most want). Returns bytes read,
// 0 on EOF, or -1 on error/timeout.
fn naes_tls_read(fd: i64, buf: i64, want: i64) -> i64 {
    (recv(fd as i32, buf as *mut u8, want, 0 as i32)) as i64
}
// Drive the TLS handshake and one request-response. Returns the hx response
// record (check https_error(r) == 0) or a negative error before the record.
// `req` is the raw HTTP/1.1 request bytes.
fn naes_tls_session(fd: i64, state: i64, ent: i64, need: i64, req: i64, req_len: i64, resp: i64) -> i64 {
    let buf: i64 = __mind_alloc(16640);
    let app: i64 = __mind_alloc(16384);
    if buf == 0 || app == 0 { return 0 - 1; }
    let mut result: i64 = naes_tls_flush(state, fd, buf);
    let mut sent: i64 = 0;
    let mut guard: i64 = 0;
    while result == 0 && guard < 256 {
        guard = guard + 1;
        let st: i64 = tls13c_status(state);
        if st == tls13c_st_error() {
            result = 0 - 1;
        } else if st == tls13c_st_hrr() {
            let ch2: i64 = __mind_alloc(8192);
            let n2: i64 = tls13c_build_client_hello2(state, ent, need, ch2);
            if n2 < 1 {
                result = 0 - 1;
            } else {
                if tls13c_seal_client_hello2(state, ch2, n2) != 0 { result = 0 - 1; }
                else { result = naes_tls_flush(state, fd, buf); }
            }
            if ch2 != 0 { __mind_free(ch2); }
        } else if st == tls13c_st_connected() && sent == 0 {
            // The measured server profile: RSA-2048 leaf.
            if tls13c_leaf_key_kind(state) != 1 || tls13c_leaf_rsa_len(state) != 256 {
                result = 0 - 2;
            } else {
                sent = 1;
                hx_mark_sent(resp);
                let mut off: i64 = 0;
                while result == 0 && off < req_len {
                    let mut n: i64 = req_len - off;
                    if n > 16384 { n = 16384; }
                    let w: i64 = tls13c_write_app(state, req + off, n);
                    if w != n {
                        result = 0 - 1;
                    } else {
                        off = off + n;
                        result = naes_tls_flush(state, fd, buf);
                    }
                }
            }
        } else if st == tls13c_st_closed() {
            result = hx_on_close(resp);
            if result == 0 { result = 0 - 1; }
        } else {
            let mut want: i64 = tls13c_in_space(state);
            if want > 16640 { want = 16640; }
            if want < 1 {
                result = 0 - 1;
            } else {
                let n: i64 = naes_tls_read(fd, buf, want);
                if n == 0 {
                    if hx_complete(resp) == 1 { result = 1; } else { result = 0 - 3; }
                } else if n < 0 {
                    result = 0 - 1;
                } else {
                    let frc: i64 = tls13c_feed(state, buf, n);
                    if frc != 0 {
                        result = 0 - 1;
                    } else {
                        // Pump records and drain app data into the response.
                        let mut going: i64 = 1;
                        while result == 0 && going == 1 {
                            if tls13c_status(state) == tls13c_st_closed() {
                                going = 0;
                            } else {
                                let prc: i64 = tls13c_pump(state);
                                if prc < 0 {
                                    result = 0 - 1;
                                } else {
                                    let k: i64 = tls13c_read_app(state, app, 16384);
                                    if k > 0 {
                                        if sent == 0 {
                                            result = 0 - 4;
                                        } else {
                                            let hrc: i64 = hx_feed(resp, app, k);
                                            if hrc != 0 {
                                                if hrc == 1 { result = 1; } else { result = hrc; }
                                            }
                                        }
                                    } else {
                                        going = 0;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if result == 0 && guard >= 256 { result = 0 - 1; }
    __mind_free(buf);
    __mind_free(app);
    result
}
