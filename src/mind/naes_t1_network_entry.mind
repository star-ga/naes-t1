// naes_t1_network_entry.mind — entry point for the compile-time evidence artifact.
//
// Concatenate this file after the network sources (naes_t1_sha256.mind,
// naes_t1_fixed.mind, naes_t1_weights.mind, naes_t1.mind, naes_t1_plan_file.mind,
// naes_t1_schedule.mind) and emit the evidence:
//   mindc <unit>.mind --emit-evidence <artifact>.mic3 --allow-nondeterministic
//   mindc verify <artifact>.mic3
// The unit reads its input at run time, so the compiler attests it as nondeterministic.
// The artifact is mic@3 with the evidence_chain MAP epilogue.
// This file adds no second decision rule. verify calls decide().

fn entry_die(code: i64, s: String) -> i64 {
    let mut put: i64 = 0;
    while put < s.len {
        let w: i64 = __mind_write(2, s.addr + put, s.len - put, 0 - 1);
        if w <= 0 {
            return code;
        }
        put = put + w;
    }
    code
}

// 1 when the NUL-terminated C string at p equals s.
fn entry_cstr_eq(p: i64, s: String) -> i64 {
    let mut i: i64 = 0;
    while i < s.len {
        if __mind_load_i8(p + i) != __mind_load_i8(s.addr + i) {
            return 0;
        }
        i = i + 1;
    }
    if __mind_load_i8(p + s.len) != 0 {
        return 0;
    }
    1
}

fn entry_read_exact(fd: i64, buf: i64, n: i64) -> i64 {
    let mut got: i64 = 0;
    while got < n {
        let r: i64 = __mind_read(fd, buf + got, n - got, 0 - 1);
        if r < 0 {
            return 0 - 1;
        }
        if r == 0 {
            if got == 0 {
                return 0;
            }
            return 0 - 1;
        }
        got = got + r;
    }
    n
}

fn entry_write_all(buf: i64, n: i64) -> i64 {
    let mut put: i64 = 0;
    while put < n {
        let w: i64 = __mind_write(1, buf + put, n - put, 0 - 1);
        if w <= 0 {
            return 0 - 1;
        }
        put = put + w;
    }
    0
}

fn entry_record_ok(rec: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 8192 {
        if __mind_load_i8(rec + i) > 15 {
            return 0;
        }
        i = i + 1;
    }
    if __mind_load_i8(rec + 8192) > 7 {
        return 0;
    }
    if rec_prev_cell(rec) < 0 - 1 || rec_prev_cell(rec) > 4095 {
        return 0;
    }
    1
}

fn entry_print_i64(fd: i64, value: i64) -> i64 {
    let buf: i64 = __mind_alloc(24);
    if buf == 0 {
        return 0 - 1;
    }
    let mut n: i64 = value;
    let mut end: i64 = 24;
    if n < 0 {
        n = 0 - n;
    }
    if n == 0 {
        end = end - 1;
        __mind_store_i8(buf + end, 48);
    }
    while n > 0 {
        end = end - 1;
        __mind_store_i8(buf + end, 48 + n % 10);
        n = n / 10;
    }
    if value < 0 {
        end = end - 1;
        __mind_store_i8(buf + end, 45);
    }
    let mut put: i64 = end;
    while put < 24 {
        let w: i64 = __mind_write(fd, buf + put, 24 - put, 0 - 1);
        if w <= 0 {
            return 0 - 1;
        }
        put = put + w;
    }
    0
}

fn entry_print_text(fd: i64, s: String) -> i64 {
    let mut put: i64 = 0;
    while put < s.len {
        let w: i64 = __mind_write(fd, s.addr + put, s.len - put, 0 - 1);
        if w <= 0 {
            return 0 - 1;
        }
        put = put + w;
    }
    0
}

fn entry_mismatch(index: i64, ea: i64, ec: i64, ga: i64, gc: i64) -> i64 {
    let a: i64 = entry_print_text(2, "MISMATCH index=");
    let b: i64 = entry_print_i64(2, index);
    let c: i64 = entry_print_text(2, " expected=(");
    let d: i64 = entry_print_i64(2, ea);
    let e: i64 = entry_print_text(2, ",");
    let f: i64 = entry_print_i64(2, ec);
    let g: i64 = entry_print_text(2, ") got=(");
    let h: i64 = entry_print_i64(2, ga);
    let i: i64 = entry_print_text(2, ",");
    let j: i64 = entry_print_i64(2, gc);
    let k: i64 = entry_print_text(2, ")\n");
    if a < 0 || b < 0 || c < 0 || d < 0 || e < 0 || f < 0 || g < 0 || h < 0 || i < 0 || j < 0 || k < 0 {
        return 0 - 1;
    }
    0
}

fn entry_signed_i16(p: i64) -> i64 {
    let n: i64 = __mind_load_i8(p) + 256 * __mind_load_i8(p + 1);
    if n >= 32768 {
        return n - 65536;
    }
    n
}

// The fixture tail is action, run, cell. decide() reads action, cell, run.
fn entry_fixture_to_request(rec: i64) -> i64 {
    let run: i64 = __mind_load_i8(rec + 8193);
    let cell: i64 = entry_signed_i16(rec + 8194);
    if run > 127 {
        return 0;
    }
    __mind_store_i16(rec + 8193, cell);
    __mind_store_i8(rec + 8195, run);
    entry_record_ok(rec)
}

// 3-byte reply: action, x, y. x and y are 255 unless the action is a click.
fn entry_write_decision(ws: i64, action: i64, out: i64) -> i64 {
    let cell: i64 = result_cell(ws);
    let mut x: i64 = 255;
    let mut y: i64 = 255;
    if cell >= 0 {
        x = cell % 64;
        y = cell / 64;
    }
    __mind_store_i8(out, action);
    __mind_store_i8(out + 1, x);
    __mind_store_i8(out + 2, y);
    entry_write_all(out, 3)
}

// records=1 writes only the 3-byte decisions on stdout. The summary goes to stderr.
fn entry_verify(model: i64, ws: i64, path: i64, records: i64) -> i64 {
    let fd: i64 = __mind_open(path);
    if fd < 0 {
        return entry_die(4, "naes_t1: cannot open fixture\n");
    }
    let header: i64 = __mind_alloc(12);
    let rec: i64 = __mind_alloc(8200);
    let out: i64 = __mind_alloc(80);
    if header == 0 || rec == 0 || out == 0 {
        return entry_die(3, "naes_t1: out of memory reading fixture\n");
    }
    if entry_read_exact(fd, header, 12) != 12 {
        return entry_die(4, "naes_t1: truncated fixture header\n");
    }
    if __mind_load_i32(header) != 1397047630 || __mind_load_i32(header + 4) != 4600148 {
        return entry_die(4, "naes_t1: fixture magic rejected\n");
    }
    let n: i64 = __mind_load_i32(header + 8);
    if n < 1 || n > 1000000 {
        return entry_die(4, "naes_t1: fixture count rejected\n");
    }
    let mut index: i64 = 0;
    let mut matches: i64 = 0;
    let mut misses: i64 = 0;
    while index < n {
        if entry_read_exact(fd, rec, 8200) != 8200 {
            return entry_die(4, "naes_t1: truncated fixture record\n");
        }
        let ea: i64 = __mind_load_i8(rec + 8196);
        let ec: i64 = entry_signed_i16(rec + 8198);
        if ea < 1 || ea > 7 || __mind_load_i8(rec + 8197) != 0 {
            return entry_die(4, "naes_t1: invalid fixture expectation\n");
        }
        if ea == 6 {
            if ec < 0 || ec > 4095 {
                return entry_die(4, "naes_t1: invalid fixture click expectation\n");
            }
        } else {
            if ec != 0 - 1 {
                return entry_die(4, "naes_t1: invalid fixture cell sentinel\n");
            }
        }
        if entry_fixture_to_request(rec) == 0 {
            return entry_die(4, "naes_t1: fixture record value out of range\n");
        }
        let action: i64 = decide(model, ws, rec, 0);
        if action < 0 {
            return entry_die(5, "naes_t1: activation guard tripped\n");
        }
        let cell: i64 = result_cell(ws);
        if action == ea && cell == ec {
            matches = matches + 1;
        } else {
            if misses < 10 {
                let m: i64 = entry_mismatch(index, ea, ec, action, cell);
                if m < 0 {
                    return 6;
                }
            }
            misses = misses + 1;
        }
        if records == 1 {
            if entry_write_decision(ws, action, out) < 0 {
                return entry_die(6, "naes_t1: write to stdout failed\n");
            }
        }
        index = index + 1;
    }
    if entry_read_exact(fd, rec, 1) != 0 {
        return entry_die(4, "naes_t1: trailing fixture bytes or read error\n");
    }
    let mut summary_fd: i64 = 1;
    if records == 1 {
        summary_fd = 2;
    }
    let a: i64 = entry_print_text(summary_fd, "MATCH ");
    let b: i64 = entry_print_i64(summary_fd, matches);
    let c: i64 = entry_print_text(summary_fd, "/");
    let d: i64 = entry_print_i64(summary_fd, n);
    let e: i64 = entry_print_text(summary_fd, "\n");
    if a < 0 || b < 0 || c < 0 || d < 0 || e < 0 {
        return 6;
    }
    if matches == n {
        return 0;
    }
    1
}

fn entry_usage() -> i64 {
    entry_die(2, "usage: naes_t1_network_entry verify WEIGHTS FIXTURE [--records]\n")
}

fn main(os_argc: i64, argv: i64) -> i64 {
    let mut argc: i64 = 0;
    while __mind_load_i64(argv + argc * 8) != 0 {
        argc = argc + 1;
    }
    if argc != 4 && argc != 5 {
        return entry_usage();
    }
    let first: i64 = __mind_load_i64(argv + 8);
    if entry_cstr_eq(first, "verify") != 1 {
        return entry_usage();
    }
    let mut records: i64 = 0;
    if argc == 5 {
        if entry_cstr_eq(__mind_load_i64(argv + 32), "--records") != 1 {
            return entry_usage();
        }
        records = 1;
    }
    let model: i64 = load_model(__mind_load_i64(argv + 16));
    if model < 0 {
        return entry_die(3, "naes_t1: weights file rejected (unreadable, bad header, shape, size or value)\n");
    }
    let ws: i64 = prepare(model);
    if ws == 0 {
        return entry_die(3, "naes_t1: out of memory preparing workspace\n");
    }
    entry_verify(model, ws, __mind_load_i64(argv + 24), records)
}
