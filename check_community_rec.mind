fn cc_glob_count(dir_cstr: i64, prefix: i64, prefix_n: i64, out_path: i64) -> i64 {
    // Count *.jsonl names that start with prefix and contain "__".
    // If exactly one, write its joined path bytes into out_path (a buffer, cleared by caller).
    let vec: i64 = read_dir(dir_cstr);
    let n: i64 = dir_vec_len(vec);
    let mut i: i64 = 0;
    let mut count: i64 = 0;
    let mut only_p: i64 = 0;
    let mut only_n: i64 = 0;
    while i < n {
        let e: i64 = dir_vec_get(vec, i);
        let np: i64 = direntry_name_addr(e);
        let nn: i64 = direntry_name_len(e);
        let mut ok: i64 = 0;
        if nn >= prefix_n + 6 {
            if cc_eq(np, prefix_n, prefix, prefix_n) == 1 {
                if cc_eq(np + nn - 6, 6, string_addr(".jsonl"), 6) == 1 {
                    let mut j: i64 = prefix_n;
                    while j + 1 < nn - 6 {
                        if __mind_load_i8(np + j) == 95 {
                            if __mind_load_i8(np + j + 1) == 95 {
                                ok = 1;
                                j = nn;
                            }
                        }
                        j = j + 1;
                    }
                }
            }
        }
        if ok == 1 {
            count = count + 1;
            only_p = np;
            only_n = nn;
        }
        i = i + 1;
    }
    if count == 1 {
        let _c: i64 = cc_bclear(out_path);
        // caller passes directory text separately; here we only store the file name
        __mind_store_i64(out_path + 24, only_p);
        __mind_store_i64(out_path + 32, only_n);
    }
    count
}

fn cc_line_action(root: i64, level: i64, count: i64, resets: i64, per: i64, nlev: i64, per_cap: i64) -> i64 {
    // Packs the updated [level, count, resets, nlev] into a 32-byte record. 0 on parse shape we skip only.
    let data: i64 = cc_get(root, "data");
    let mut data_o: i64 = 0;
    if data != 0 {
        if jv_kind(data) == jv_kind_object() {
            data_o = data;
        }
    }
    let mut skip: i64 = 0;
    let mut is_reset: i64 = 0;
    let mut acted: i64 = 0;
    if data_o == 0 {
        skip = 1;
    } else {
        let ai: i64 = cc_get(data_o, "action_input");
        if ai == 0 {
            skip = 1;
        } else {
            if jv_kind(ai) != jv_kind_object() {
                skip = 1;
            } else {
                let idh: i64 = cc_get(ai, "id");
                if idh == 0 {
                    skip = 1;
                } else {
                    if jv_kind(idh) == jv_kind_null() {
                        skip = 1;
                    } else {
                        if jv_kind(idh) == jv_kind_string() {
                            acted = 1;
                            if cc_eq(jv_s_addr(idh), jv_s_len(idh), string_addr("RESET"), 5) == 1 {
                                is_reset = 1;
                            }
                        } else {
                            if jv_kind(idh) == jv_kind_number() {
                                acted = 1;
                                if jv_n_is_int(idh) == 1 {
                                    if jv_n_neg(idh) == 0 {
                                        if jv_n_int(idh) == 0 {
                                            is_reset = 1;
                                        }
                                    }
                                }
                            } else {
                                skip = 1;
                            }
                        }
                    }
                }
            }
        }
    }
    let mut ncount: i64 = count;
    let mut nresets: i64 = resets;
    let mut nlevel: i64 = level;
    let mut nnlev: i64 = nlev;
    if skip == 0 {
        if acted == 1 {
            if is_reset == 1 {
                nresets = resets + 1;
            } else {
                ncount = count + 1;
            }
        }
        let mut lc: i64 = 0;
        let lch: i64 = cc_get(data_o, "levels_completed");
        if lch != 0 {
            if jv_kind(lch) == jv_kind_number() {
                lc = cc_int(lch);
            }
        }
        if lc > level {
            if nnlev < per_cap {
                __mind_store_i64(per + nnlev * 8, ncount);
                nnlev = nnlev + 1;
            }
            ncount = 0;
            nlevel = lc;
        }
    }
    let packed: i64 = __mind_alloc(32);
    __mind_store_i64(packed + 0, nlevel);
    __mind_store_i64(packed + 8, ncount);
    __mind_store_i64(packed + 16, nresets);
    __mind_store_i64(packed + 24, nnlev);
    packed
}

fn cc_parse_recording(path_cstr: i64, per: i64, per_cap: i64) -> i64 {
    // Returns [n_levels, resets, ok]. ok is 0 when a non-empty line does not parse.
    let rec: i64 = cc_load(path_cstr);
    let base: i64 = __mind_load_i64(rec + 0);
    let n: i64 = __mind_load_i64(rec + 8);
    let out: i64 = __mind_alloc(24);
    __mind_store_i64(out + 0, 0);
    __mind_store_i64(out + 8, 0);
    __mind_store_i64(out + 16, 1);
    if n < 0 {
        __mind_store_i64(out + 16, 0);
        return out;
    }
    let mut level: i64 = 0;
    let mut count: i64 = 0;
    let mut resets: i64 = 0;
    let mut nlev: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let start: i64 = i;
        let mut hit: i64 = 0;
        while hit == 0 {
            if i >= n {
                hit = 1;
            } else {
                if __mind_load_i8(base + i) == 10 {
                    hit = 1;
                } else {
                    i = i + 1;
                }
            }
        }
        let mut use_n: i64 = i - start;
        if use_n > 0 {
            if __mind_load_i8(base + start + use_n - 1) == 13 {
                use_n = use_n - 1;
            }
        }
        if use_n > 0 {
            let root: i64 = jv_parse(base + start, use_n);
            if root == 0 {
                __mind_store_i64(out + 16, 0);
                return out;
            }
            let packed: i64 = cc_line_action(root, level, count, resets, per, nlev, per_cap);
            let _fj: i64 = jv_free(root);
            level = __mind_load_i64(packed + 0);
            count = __mind_load_i64(packed + 8);
            resets = __mind_load_i64(packed + 16);
            nlev = __mind_load_i64(packed + 24);
            let _fp: i64 = __mind_free(packed);
        }
        if i < n {
            i = i + 1;
        }
    }
    __mind_store_i64(out + 0, nlev);
    __mind_store_i64(out + 8, resets);
    let _fb: i64 = __mind_free(base);
    let _fh: i64 = __mind_free(rec);
    out
}

