pub fn read_to_string(path_addr: i64) -> i64 {
    let rec: i64 = __mind_alloc(24);
    __mind_store_i64(rec + 0, 0);
    __mind_store_i64(rec + 8, 0);
    __mind_store_i64(rec + 16, 0);
    let fd: i64 = open(path_addr as *const u8, o_rdonly() as i32, 0) as i64;
    if fd < 0 {
        return rec;
    }
    let file_sz: i64 = lseek(fd as i32, 0, seek_end() as i32);
    if file_sz < 0 {
        let _ = close(fd as i32);
        return rec;
    }
    let _ = lseek(fd as i32, 0, seek_set() as i32);
    let buf: i64 = __mind_alloc(file_sz + 1);
    let n: i64 = read(fd as i32, buf as *mut u8, file_sz);
    let _ = close(fd as i32);
    if n < 0 {
        return rec;
    }
    __mind_store_i8(buf + n, 0);
    __mind_store_i64(rec + 0, buf);
    __mind_store_i64(rec + 8, n);
    __mind_store_i64(rec + 16, file_sz + 1);
    rec
}

// try_read_to_string — same as read_to_string; returns empty string on error.
pub fn try_read_to_string(path_addr: i64) -> i64 {
    read_to_string(path_addr)
}

// ---------------------------------------------------------------------------
// Native-ELF-safe file read.
//
// read_to_string above uses libc `extern "C"` open/lseek/close/read, which are
// UNAVAILABLE in a freestanding native-ELF program (no libc linked). The two
// helpers below use ONLY raw syscalls, via the `__mind_open` (open(2), O_RDONLY)
// and `__mind_read` intrinsics — no lseek (the read loops to EOF instead of
// stat-ing the size) and no close (a single-shot reader relies on process exit to
// reclaim the fd; there is no `__mind_close` intrinsic yet). The path MUST be a
// NUL-terminated C string — an argv[i] pointer from `__mind_argv` already is; a
// std.string String's backing bytes are not, so NUL-terminate before passing one.
// `__mind_open` is wired through BOTH backends that can compile this module: the
// native-ELF emitter recognises it directly (main.mind nb_intrinsic_id slot 12),
// and it carries a STD_SURFACE_INTRINSICS row (arity 1, Det::Pure) with a C
// definition in runtime-support/mind_intrinsics.c, so `mindc --emit-shared` emits
// a plain `func.call @__mind_open` that links into the cdylib.
// deferred: add a `__mind_close` intrinsic + close here for long-running readers
// that open many files (upgrade path: mirror __mind_open with SYS_close=3).
// ---------------------------------------------------------------------------

// Read from `fd` into `buf_addr` up to `cap` bytes, looping until EOF/error (a
// single read(2) may return short). Sequential (offset -1). Returns total read
// on a clean EOF (n == 0), or -1 if a read(2) call itself fails (n < 0, a raw
// negative-errno return) — the two are NOT the same outcome: an error mid-read
// must not be silently reported as "read the whole file, got `got` bytes".
fn fs_read_fd_all(fd: i64, buf_addr: i64, cap: i64, got: i64) -> i64 {
    if got >= cap {
        return got;
    }
    let n: i64 = __mind_read(fd, buf_addr + got, cap - got, 0 - 1);
    if n == 0 {
        return got;
    }
    if n < 0 {
        return 0 - 1;
    }
    fs_read_fd_all(fd, buf_addr, cap, got + n)
}

// read_file_native — open the NUL-terminated C-string path read-only and read its
// contents into `buf_addr` (up to `cap` bytes). Returns the byte count (0 for an
// empty file), or -1 if the path could not be opened OR a read(2) call failed
// partway through (see fs_read_fd_all) — either way, the caller did not get the
// complete file and must not treat the returned buffer as valid.
pub fn read_file_native(path_addr: i64, buf_addr: i64, cap: i64) -> i64 {
    let fd: i64 = __mind_open(path_addr);
    if fd < 0 {
        return 0 - 1;
    }
    fs_read_fd_all(fd, buf_addr, cap, 0)
}

// write_string — write buf_len bytes at buf_addr to path (create or truncate).
// Returns 1 on success, 0 on error.
pub fn write_string(path_addr: i64, buf_addr: i64, buf_len: i64) -> i64 {
    let flags: i64 = o_wronly() + o_creat() + o_trunc();
    let fd: i64 = open(path_addr as *const u8, flags as i32, 420) as i64;
    if fd < 0 {
        return 0;
    }
    let n: i64 = write(fd as i32, buf_addr as *const u8, buf_len);
    let _ = close(fd as i32);
    if n == buf_len {
        1
    } else {
        0
    }
}

// ---------------------------------------------------------------------------
// Internal: readdir loop via recursion
// ---------------------------------------------------------------------------

// Populate vec_h by reading all entries from dirp, skipping "." and "..".
fn fs_readdir_rec(vec_h: i64, dirp: i64) -> i64 {
    let ep: i64 = readdir(dirp as *mut u8) as i64;
    if ep == 0 {
        0
    } else {
        let d_type: i64 = __mind_load_i8(ep + 18);
        let name_ptr: i64 = ep + 19;
        let b0: i64 = __mind_load_i8(name_ptr);
        let b1: i64 = __mind_load_i8(name_ptr + 1);
        let skip: i64 = if b0 == 46 {
            if b1 == 0 {
                1
            } else {
                if b1 == 46 {
                    let b2: i64 = __mind_load_i8(name_ptr + 2);
                    if b2 == 0 {
                        1
                    } else {
                        0
                    }
                } else {
                    0
                }
            }
        } else {
            0
        };
        if skip == 0 {
            let name_len: i64 = fs_cstr_len(name_ptr);
            let name_copy: i64 = fs_heap_copy(name_ptr, name_len);
            let flags: i64 = if d_type == dt_dir() {
                1
            } else {
                if d_type == dt_reg() {
                    2
                } else {
                    0
                }
            };
            let entry: i64 = __mind_alloc(24);
            __mind_store_i64(entry + 0, name_copy);
            __mind_store_i64(entry + 8, name_len);
            __mind_store_i64(entry + 16, flags);
            let _ = fs_vec_push(vec_h, entry);
        }
        fs_readdir_rec(vec_h, dirp)
    }
}

// ---------------------------------------------------------------------------
// Public: directory listing
// ---------------------------------------------------------------------------

// read_dir — list entries in directory at path_addr.
// Returns a Vec<DirEntry> heap record. Excludes "." and "..".
pub fn read_dir(path_addr: i64) -> i64 {
    let vec_h: i64 = __mind_alloc(24);
    __mind_store_i64(vec_h + 0, 0);
    __mind_store_i64(vec_h + 8, 0);
    __mind_store_i64(vec_h + 16, 0);
    let dirp: i64 = opendir(path_addr as *const u8) as i64;
    if dirp == 0 {
        return vec_h;
    }
    let _ = fs_readdir_rec(vec_h, dirp);
    let _ = closedir(dirp as *mut u8);
    vec_h
}

// ---------------------------------------------------------------------------
// Public: directory creation / removal
// ---------------------------------------------------------------------------

// fs_mkdir — create directory with given mode. Returns 1 on success.
pub fn fs_mkdir(path_addr: i64, mode: i64) -> i64 {
    let r: i64 = mkdir(path_addr as *const u8, mode as i32) as i64;
    if r == 0 {
        1
    } else {
        0
    }
}

// Internal: walk path bytes creating intermediate dirs via tail recursion.
// work: mutable copy of path (heap), plen: total path length.
